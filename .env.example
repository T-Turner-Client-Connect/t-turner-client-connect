# Copy to .env for local development. Placeholders only — never commit real values.

# PostgreSQL connection string for local development. Not needed on Netlify:
# deployed sites use Netlify Database automatically (NETLIFY_DB_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public base URL of the site, used in links (invites, password resets, unsubscribe).
APP_URL="https://your-site.netlify.app"

# One-time code that allows creating the first Admin at /setup. 16+ random characters.
# Remove or rotate after the first Admin exists.
SETUP_TOKEN="replace-with-a-long-random-string"

# --- Email (Resend) — password resets now, campaigns in stage 2 -----------------
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="T. Turner & Associates <updates@yourdomain.com>"
# Postal address shown in promotional email footers (required by CAN-SPAM).
BUSINESS_MAILING_ADDRESS=""

# --- Twilio SMS/MMS — stage 2 ----------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Live sending stays off until auth, permissions, provider setup and test delivery are verified.
LIVE_SENDING_ENABLED="false"

# Optional: force file storage driver ("netlify" or "local"). Auto-detected on Netlify.
# STORAGE_DRIVER=""

# Optional: your Twilio prices, used only for the cost estimate on campaign previews.
SMS_PRICE_PER_SEGMENT_USD=""
MMS_PRICE_PER_MESSAGE_USD=""
