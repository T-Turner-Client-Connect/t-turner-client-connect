# Copy to .env for local development. Placeholders only — never commit real values.

# PostgreSQL connection string (Netlify DB / Neon / Supabase / any Postgres 14+).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public base URL of the site, used in links (invites, password resets, unsubscribe).
APP_URL="https://your-site.netlify.app"

# One-time code that allows creating the first Admin at /setup. 16+ random characters.
# Remove or rotate after the first Admin exists.
SETUP_TOKEN="replace-with-a-long-random-string"

# --- Email (Resend) — password resets now, campaigns in stage 2 -----------------
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="T. Turner & Associates <updates@yourdomain.com>"
# Postal address shown in promotional email footers (required by CAN-SPAM).
BUSINESS_MAILING_ADDRESS=""

# --- Twilio SMS/MMS — stage 2 ----------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM_NUMBER=""

# Live sending stays off until auth, permissions, provider setup and test delivery are verified.
LIVE_SENDING_ENABLED="false"

# Optional: force file storage driver ("netlify" or "local"). Auto-detected on Netlify.
# STORAGE_DRIVER=""

# Optional: your Twilio prices, used only for the cost estimate on campaign previews.
SMS_PRICE_PER_SEGMENT_USD=""
MMS_PRICE_PER_MESSAGE_USD=""

# Encrypts MFA secrets at rest and signs expiring download links. 32+ random characters.
# Generate with: openssl rand -base64 48   (changing it signs everyone out of MFA)
APP_ENCRYPTION_KEY=""

# --- Client portal notifications & automations --------------------------------
# Portal "you have something new" notices (sign-in link only). Off until providers are verified.
NOTIFICATIONS_ENABLED="false"
# Shared secret for the hourly automations function (netlify/functions/automations-cron.mts).
CRON_SECRET=""

# --- Malware scanning (optional) ----------------------------------------------
# HTTP scanner that accepts the raw file and returns {"clean": true|false}.
MALWARE_SCAN_URL=""
MALWARE_SCAN_TOKEN=""

# --- Jotform contracts ---------------------------------------------------------
# Form links work without these; verified completion needs both.
JOTFORM_API_KEY=""
JOTFORM_WEBHOOK_SECRET=""
# Only change for Jotform EU/HIPAA accounts (e.g. https://eu-api.jotform.com).
# JOTFORM_API_BASE=""
# JOTFORM_FORM_BASE=""

# --- Tax e-signatures ----------------------------------------------------------
# Leave blank until a provider has been verified for the specific tax forms,
# identity-verification rules and joint-return signers.
SIGNING_PROVIDER=""
SIGNING_PROVIDER_VERIFIED_FOR_TAX="false"
