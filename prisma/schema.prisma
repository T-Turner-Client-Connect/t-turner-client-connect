// TTurner Client Connect — data model
//
// Design notes:
// - Every staff account is invite-only. Sessions are stored server-side
//   (only a SHA-256 hash of the cookie token is kept), so revoking a user or
//   a session takes effect immediately.
// - Clients are never hard-deleted by the app: archiving sets `archivedAt`
//   and keeps notes, consent history, campaign history and audit history.
// - Consent is append-only history (`ConsentRecord`). The current state for a
//   client/contact + kind is the newest record. Imports never write consent.
// - Opt-outs are also recorded per address in `Suppression`, so a STOP or an
//   unsubscribe follows the phone number / email address even if it later
//   appears on another client record or in a re-import.
// - No SSNs, taxpayer IDs, dates of birth, income, bank details, dependents
//   or tax-return documents are modelled anywhere. Imports are restricted to
//   an allow-list of contact fields (see src/lib/import/fields.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// STAFF ACCOUNTS & ACCESS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(STAFF)
  passwordHash String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  resetTokens     PasswordResetToken[]
  invitesSent     Invite[]             @relation("InvitedBy")
  assignedClients Client[]             @relation("AssignedStaff")
  assignedTasks   Task[]               @relation("TaskAssignee")
  createdTasks    Task[]               @relation("TaskCreator")
  notes           ClientNote[]
  auditLogs       AuditLog[]
  imports         ImportBatch[]
  campaigns       Campaign[]
  files           StoredFile[]
  consentRecords  ConsentRecord[]      @relation("ConsentRecordedBy")
  consentReviews  ConsentRecord[]      @relation("ConsentReviewedBy")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        Role      @default(STAFF)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Failed logins, used for throttling brute-force attempts.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// CLIENTS
// ---------------------------------------------------------------------------

enum ClientType {
  INDIVIDUAL
  BUSINESS
  NONPROFIT
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

model Client {
  id               String       @id @default(cuid())
  firstName        String?
  lastName         String?
  // Display name: "First Last" for individuals, or the business name.
  displayName      String
  businessName     String?
  email            String?
  emailNormalized  String?
  phone            String?
  // E.164 (+15551234567) when the number could be parsed, used for matching.
  phoneNormalized  String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  clientType       ClientType   @default(INDIVIDUAL)
  status           ClientStatus @default(ACTIVE)
  services         String[]
  tags             String[]
  notes            String?
  // True when the record (or part of it) came from tax-preparation software
  // such as a TaxAct export. Drives Section 7216 eligibility checks.
  taxReturnDerived Boolean      @default(false)
  source           String?
  assignedToId     String?
  assignedTo       User?        @relation("AssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  contacts           Contact[]
  groups             ClientGroup[]
  clientNotes        ClientNote[]
  tasks              Task[]
  consentRecords     ConsentRecord[]
  auditLogs          AuditLog[]
  campaignInclusions CampaignInclusion[]
  campaignExclusions CampaignExclusion[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([displayName])
  @@index([archivedAt])
}

// Additional people at a business (or a spouse/household member).
model Contact {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  title           String?
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consentRecords ConsentRecord[]

  @@index([clientId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  clients   ClientGroup[]
  campaigns CampaignGroup[]
}

model ClientGroup {
  clientId String
  groupId  String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@id([clientId, groupId])
  @@index([groupId])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// CONSENT & SUPPRESSION
// ---------------------------------------------------------------------------

enum ConsentKind {
  SMS_MARKETING
  SMS_SERVICE
  EMAIL_MARKETING
  TAX_INFO_USE
  TAX_INFO_DISCLOSURE
}

enum ConsentStatus {
  GRANTED
  REVOKED
  UNKNOWN
}

model ConsentRecord {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Null = applies to the client's primary email/phone.
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind           ConsentKind
  status         ConsentStatus
  // Free text describing exactly what was agreed to (e.g. "Promotions for
  // bookkeeping and payroll services by text, up to 4/month").
  scope          String?
  // Where it came from: "Signed consent form", "Consent page", "STOP reply"...
  source         String
  evidenceNote   String?
  evidenceFileId String?
  evidenceFile   StoredFile?   @relation(fields: [evidenceFileId], references: [id])
  effectiveAt    DateTime      @default(now())
  expiresAt      DateTime?
  recordedById   String?
  recordedBy     User?         @relation("ConsentRecordedBy", fields: [recordedById], references: [id])
  // Section 7216 records must be reviewed by an Admin before they count.
  reviewedById   String?
  reviewedBy     User?         @relation("ConsentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([clientId, kind, createdAt])
  @@index([contactId, kind, createdAt])
}

enum Channel {
  EMAIL
  SMS
}

enum SuppressionReason {
  STOP
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
  MANUAL
}

model Suppression {
  id                String            @id @default(cuid())
  channel           Channel
  addressNormalized String
  reason            SuppressionReason
  note              String?
  createdById       String?
  createdAt         DateTime          @default(now())
  // Set when an opt-out is lifted (e.g. client replies START with new consent).
  liftedAt          DateTime?

  @@index([channel, addressNormalized])
}

// ---------------------------------------------------------------------------
// TASKS
// ---------------------------------------------------------------------------

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id          String       @id @default(cuid())
  title       String
  details     String?
  dueAt       DateTime?
  remindAt    DateTime?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(OPEN)
  completedAt DateTime?
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, dueAt])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// FILES (flyers, consent evidence)
// ---------------------------------------------------------------------------

enum FileKind {
  FLYER
  CONSENT_EVIDENCE
}

model StoredFile {
  id           String    @id @default(cuid())
  kind         FileKind
  // Key inside the private storage bucket. Never a public URL.
  storageKey   String    @unique
  originalName String
  title        String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  archivedAt   DateTime?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  campaigns      Campaign[]
  consentRecords ConsentRecord[]
}

// ---------------------------------------------------------------------------
// CAMPAIGNS
// ---------------------------------------------------------------------------

enum CampaignPurpose {
  // Appointment reminders, missing documents, deadlines — not promotional.
  SERVICE
  // Promotion of tax-preparation services.
  TAX_PREP_PROMO
  // Promotion of other services (bookkeeping, payroll, nonprofit, ...).
  OTHER_SERVICES_PROMO
}

enum CampaignChannel {
  EMAIL
  SMS
  BOTH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id           String          @id @default(cuid())
  title        String
  purpose      CampaignPurpose @default(SERVICE)
  channel      CampaignChannel @default(EMAIL)
  emailSubject String?
  // Plain text with light formatting (blank line = paragraph, **bold**).
  body         String          @default("")
  // Optional shorter text for SMS; falls back to `body`.
  smsBody      String?
  flyerId      String?
  flyer        StoredFile?     @relation(fields: [flyerId], references: [id], onDelete: SetNull)
  status       CampaignStatus  @default(DRAFT)
  scheduledAt  DateTime?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  groups     CampaignGroup[]
  inclusions CampaignInclusion[]
  exclusions CampaignExclusion[]
}

model CampaignGroup {
  campaignId String
  groupId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([campaignId, groupId])
}

// Individually selected clients.
model CampaignInclusion {
  campaignId String
  clientId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([campaignId, clientId])
}

// Campaign-only exclusions. They never touch group membership or the client
// record, and they survive changes to the campaign's audience selection.
model CampaignExclusion {
  campaignId String
  clientId   String
  reason     String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([campaignId, clientId])
}

// ---------------------------------------------------------------------------
// IMPORTS
// ---------------------------------------------------------------------------

enum ImportStatus {
  REVIEW
  COMMITTED
  DISCARDED
}

model ImportBatch {
  id           String       @id @default(cuid())
  source       String
  fileName     String
  status       ImportStatus @default(REVIEW)
  // Column mapping used (header -> CRM field). No cell data.
  mapping      Json
  updateMode   String       @default("fill_blanks")
  importedById String
  importedBy   User         @relation(fields: [importedById], references: [id])
  createdAt    DateTime     @default(now())
  committedAt  DateTime?
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  errorCount   Int          @default(0)

  rows ImportRow[]
}

enum ImportMatch {
  NEW
  MATCH
  AMBIGUOUS
  ERROR
}

model ImportRow {
  id             String      @id @default(cuid())
  batchId        String
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  // Mapped, allow-listed fields only. Cleared after commit/discard.
  data           Json?
  errors         String[]
  warnings       String[]
  match          ImportMatch
  candidateIds   String[]
  // Staff decision: "create", "update:<clientId>", or "skip".
  decision       String?
  resultClientId String?

  @@index([batchId, rowNumber])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Field names changed and non-sensitive context. Never raw import files.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
