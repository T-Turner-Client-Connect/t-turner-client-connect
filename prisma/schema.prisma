// TTurner Client Connect — data model
//
// Design notes:
// - Every staff account is invite-only. Sessions are stored server-side
//   (only a SHA-256 hash of the cookie token is kept), so revoking a user or
//   a session takes effect immediately.
// - Clients are never hard-deleted by the app: archiving sets `archivedAt`
//   and keeps notes, consent history, campaign history and audit history.
// - Consent is append-only history (`ConsentRecord`). The current state for a
//   client/contact + kind is the newest record. Imports never write consent.
// - Opt-outs are also recorded per address in `Suppression`, so a STOP or an
//   unsubscribe follows the phone number / email address even if it later
//   appears on another client record or in a re-import.
// - No SSNs, taxpayer IDs, dates of birth, income, bank details, dependents
//   or tax-return documents are modelled anywhere. Imports are restricted to
//   an allow-list of contact fields (see src/lib/import/fields.ts).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// STAFF ACCOUNTS & ACCESS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
}

model User {
  id                          String                  @id @default(cuid())
  email                       String                  @unique
  name                        String
  role                        Role                    @default(STAFF)
  passwordHash                String?
  active                      Boolean                 @default(true)
  // TOTP secret (base32), stored encrypted with APP_ENCRYPTION_KEY.
  mfaSecretEnc                String?
  mfaEnabledAt                DateTime?
  // Last accepted authenticator time-step: a code can't be replayed.
  mfaLastStep                 Int?
  // Proven by entering a code emailed to this address (enables email codes).
  emailVerifiedAt             DateTime?
  lastLoginAt                 DateTime?
  // Admin-granted: open identity documents for every client (not only
  // assigned ones). Has no effect on the Owner's Office, which is bound to
  // the owner's own account.
  identityAccessAll           Boolean                 @default(false)
  identityAccessGrantedBy     String?
  identityAccessGrantedAt     DateTime?
  // Tabitha can let a staff member manage bookkeeping billing.
  bookkeepingBillingAccess    Boolean                 @default(false)
  bookkeepingBillingGrantedBy String?
  bookkeepingBillingGrantedAt DateTime?
  // Owner-granted: may REQUEST a Managed Business conversion. Never approves.
  businessConversionAccess    Boolean                 @default(false)
  businessConversionGrantedBy String?
  businessConversionGrantedAt DateTime?
  businessAccessRequests      BusinessAccessRequest[] @relation("BusinessAccessRequester")
  businessAccessDecisions     BusinessAccessRequest[] @relation("BusinessAccessDecider")
  businessAccessEvents        BusinessAccessEvent[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  sessions         Session[]
  resetTokens      PasswordResetToken[]
  invitesSent      Invite[]             @relation("InvitedBy")
  assignedClients  Client[]             @relation("AssignedStaff")
  assignedServices ClientService[]      @relation("ServiceAssignee")
  assignedTasks    Task[]               @relation("TaskAssignee")
  createdTasks     Task[]               @relation("TaskCreator")
  notes            ClientNote[]
  auditLogs        AuditLog[]
  imports          ImportBatch[]
  campaigns        Campaign[]
  files            StoredFile[]
  consentRecords   ConsentRecord[]      @relation("ConsentRecordedBy")
  consentReviews   ConsentRecord[]      @relation("ConsentReviewedBy")
  recoveryCodes    MfaRecoveryCode[]
  conversations    Conversation[]       @relation("ConversationAssignee")
  messages         Message[]            @relation("StaffMessages")
  documents        Document[]           @relation("StaffDocuments")
  periods          BookkeepingPeriod[]
  docRequests      DocumentRequest[]
  announcements    Announcement[]
  signatureReqs    SignatureRequest[]
  contracts        ContractAssignment[]
  portalInvites    PortalInvite[]
  ownerAccess      OwnerAccess?         @relation("OwnerAccessUser")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  // False until the second factor is verified; a half-signed-in session can
  // only reach the MFA screens.
  mfaPassed  Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id                     String    @id @default(cuid())
  email                  String
  name                   String
  role                   Role      @default(STAFF)
  tokenHash              String    @unique
  expiresAt              DateTime
  acceptedAt             DateTime?
  revokedAt              DateTime?
  invitedById            String
  invitedBy              User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt              DateTime  @default(now())
  // Permissions applied when the invitation is accepted (Staff role only).
  grantIdentityAccessAll Boolean   @default(false)
  // Bookkeeping billing access — only Tabitha can include it.
  grantBillingAccess     Boolean   @default(false)

  // Staff invitation email (transactional; never part of campaigns or client mail).
  // DELIVERED is set only from a signed Resend delivery event.
  emailStatus      InviteEmailStatus @default(NOT_SENT)
  emailProviderId  String?           @unique
  emailAttemptAt   DateTime?
  emailAcceptedAt  DateTime?
  emailDeliveredAt DateTime?
  emailFailedAt    DateTime?
  emailError       String?
  // Set when the Admin took the private copy-link instead of (or after) email.
  linkCopiedAt     DateTime?
  // The newer invitation that replaced this one (resend / new private link).
  replacedById     String?
  // Form idempotency key, so a double-submit can't create or email twice.
  createKey        String?           @unique

  @@index([email])
}

enum InviteEmailStatus {
  NOT_SENT
  SENDING
  ACCEPTED
  DELIVERED
  FAILED
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Failed logins, used for throttling brute-force attempts.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// CLIENTS
// ---------------------------------------------------------------------------

enum ClientType {
  INDIVIDUAL
  BUSINESS
  NONPROFIT
}

/// Managed Business Client access for one client record (one business).
/// OFF for everyone by default — registration answers, client type, tax return
/// type and services never change it. Only the owner can turn it ACTIVE, after
/// a request; REMOVED blocks access at once and keeps every record.
enum BusinessAccess {
  OFF
  ACTIVE
  REMOVED
}

enum BusinessAccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

model Client {
  id                      String                  @id @default(cuid())
  firstName               String?
  // Middle name or initial, kept separate from the first name.
  middleName              String?
  lastName                String?
  // What the client likes to be called ("Liz" for Elizabeth). Used in greetings.
  preferredName           String?
  // Display name: "First Last" for individuals, or the business name.
  displayName             String
  businessName            String?
  email                   String?
  emailNormalized         String?
  phone                   String?
  // E.164 (+15551234567) when the number could be parsed, used for matching.
  phoneNormalized         String?
  // Spouse on a joint return. One client record holds the couple; each tax
  // year's TaxPrepCase keeps that year's filing details. The spouse's contact
  // details are separate from the client's own (and their messaging consent).
  spouseFirstName         String?
  spouseMiddleName        String?
  spouseLastName          String?
  spouseEmail             String?
  spousePhone             String?
  spousePhoneNormalized   String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  clientType              ClientType              @default(INDIVIDUAL)
  // Regular Tax Client unless the owner approved Managed Business access.
  // clientType is informational only and never grants business access.
  businessAccess          BusinessAccess          @default(OFF)
  businessAccessChangedAt DateTime?
  businessAccessChangedBy String?
  businessAccessRequests  BusinessAccessRequest[]
  businessAccessEvents    BusinessAccessEvent[]
  status                  ClientStatus            @default(ACTIVE)
  services                String[]
  tags                    String[]
  notes                   String?
  // The client's ID in TaxAct (or other tax software), used to match
  // e-file status imports. Never matched by name alone.
  taxSoftwareId           String?                 @unique
  // True when the record (or part of it) came from tax-preparation software
  // such as a TaxAct export. Drives Section 7216 eligibility checks.
  taxReturnDerived        Boolean                 @default(false)
  // Tax entity for deadline cards: SOLE_PROPRIETOR | PARTNERSHIP | S_CORP |
  // C_CORP | NONPROFIT | TRUST_ESTATE. Null = not recorded yet.
  entityType              String?
  // Month (1–12) the business's tax year ends. Null = calendar year (December).
  fiscalYearEnd           Int?
  // Does this owner have a nonprofit? YES | NO | NOT_CONFIRMED (null = not asked yet). Kept on the owner's main record.
  hasNonprofit            String?
  source                  String?
  assignedToId            String?
  assignedTo              User?                   @relation("AssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  archivedAt              DateTime?
  // Set when staff merged this duplicate into another record (it is archived,
  // never deleted, so its own history stays readable).
  mergedIntoId            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  contacts              Contact[]
  groups                ClientGroup[]
  clientNotes           ClientNote[]
  tasks                 Task[]
  consentRecords        ConsentRecord[]
  commPrefs             CommunicationPreference[]
  commPrefChanges       CommunicationPreferenceChange[]
  auditLogs             AuditLog[]
  campaignInclusions    CampaignInclusion[]
  campaignExclusions    CampaignExclusion[]
  portalAccess          PortalAccess[]
  refundTransfers       RefundTransferPayment[]
  portalInvites         PortalInvite[]
  conversations         Conversation[]
  documents             Document[]
  periods               BookkeepingPeriod[]
  docRequests           DocumentRequest[]
  announcements         Announcement[]
  deadlines             ClientDeadline[]
  signatureReqs         SignatureRequest[]
  contracts             ContractAssignment[]
  installmentPlans      InstallmentPlan[]
  invoices              Invoice[]
  clientServices        ClientService[]
  payments              Payment[]
  appointments          Appointment[]
  pipelineCards         PipelineCard[]
  filings               FilingRecord[]
  taxSummaries          TaxReturnSummary[]
  questionnaires        QuestionnaireSubmission[]
  identityPeople        IdentityPerson[]
  identityDocs          IdentityDocument[]
  bookkeepingProfile    BookkeepingProfile?
  bookkeepingAccounts   BookkeepingAccount[]
  bookkeepingBilling    BookkeepingBilling?
  squareBillings        SquareBillingMember[]
  ledgerBook            LedgerBook?
  nonprofitProfile      NonprofitProfile?
  nonprofitPortfolio    NonprofitPortfolio?
  chargeAuthorizations  RecurringChargeAuthorization[]
  businessOnboarding    BusinessOnboarding?
  taxPrepCases          TaxPrepCase[]
  questionnaireRequests QuestionnaireRequest[]
  // A person (Personal record) linked to the businesses they own, and back.
  ownsBusinesses        ClientRelationship[]            @relation("RelPerson")
  ownedBy               ClientRelationship[]            @relation("RelBusiness")
  noticeCases           NoticeCase[]
  businessInfoChanges   BusinessInfoChange[]
  taxYearProgress       TaxYearProgress[]
  manualBillingPayments ManualBillingPayment[]
  businessLicenses      BusinessLicense[]
  yearEndFilings        YearEndFiling[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([displayName])
  @@index([archivedAt])
}

// Additional people at a business (or a spouse/household member).
model Contact {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  // What this contact likes to be called; used to greet them in the portal.
  preferredName   String?
  title           String?
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consentRecords ConsentRecord[]
  portalUser     PortalUser?
  commPrefs      CommunicationPreference[]

  @@index([clientId])
  @@index([emailNormalized])
  @@index([phoneNormalized])
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  clients       ClientGroup[]
  campaigns     CampaignGroup[]
  announcements AnnouncementGroup[]
}

model ClientGroup {
  clientId String
  groupId  String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@id([clientId, groupId])
  @@index([groupId])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// CONSENT & SUPPRESSION
// ---------------------------------------------------------------------------

enum ConsentKind {
  SMS_MARKETING
  SMS_SERVICE
  EMAIL_MARKETING
  TAX_INFO_USE
  TAX_INFO_DISCLOSURE
}

enum ConsentStatus {
  GRANTED
  REVOKED
  UNKNOWN
}

model ConsentRecord {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Null = applies to the client's primary email/phone.
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind           ConsentKind
  status         ConsentStatus
  // Free text describing exactly what was agreed to (e.g. "Promotions for
  // bookkeeping and payroll services by text, up to 4/month").
  scope          String?
  // Where it came from: "Signed consent form", "Consent page", "STOP reply"...
  source         String
  evidenceNote   String?
  evidenceFileId String?
  evidenceFile   StoredFile?   @relation(fields: [evidenceFileId], references: [id])
  effectiveAt    DateTime      @default(now())
  expiresAt      DateTime?
  recordedById   String?
  recordedBy     User?         @relation("ConsentRecordedBy", fields: [recordedById], references: [id])
  // Section 7216 records must be reviewed by an Admin before they count.
  reviewedById   String?
  reviewedBy     User?         @relation("ConsentReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([clientId, kind, createdAt])
  @@index([contactId, kind, createdAt])
}

enum Channel {
  EMAIL
  SMS
}

enum SuppressionReason {
  STOP
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
  MANUAL
}

model Suppression {
  id                String            @id @default(cuid())
  channel           Channel
  addressNormalized String
  reason            SuppressionReason
  note              String?
  createdById       String?
  createdAt         DateTime          @default(now())
  // Set when an opt-out is lifted (e.g. client replies START with new consent).
  liftedAt          DateTime?

  @@index([channel, addressNormalized])
}

// ---------------------------------------------------------------------------
// TASKS
// ---------------------------------------------------------------------------

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id          String       @id @default(cuid())
  title       String
  details     String?
  dueAt       DateTime?
  remindAt    DateTime?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(OPEN)
  completedAt DateTime?
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, dueAt])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// FILES (flyers, consent evidence)
// ---------------------------------------------------------------------------

enum FileKind {
  FLYER
  CONSENT_EVIDENCE
  // Client documents live in a separate private store from marketing files.
  CLIENT_DOCUMENT
}

model StoredFile {
  id                     String      @id @default(cuid())
  kind                   FileKind
  // Key inside the private storage bucket. Never a public URL.
  storageKey             String      @unique
  originalName           String
  title                  String
  mimeType               String
  sizeBytes              Int
  width                  Int?
  height                 Int?
  archivedAt             DateTime?
  // Exactly one of these is set: staff upload or client (portal) upload.
  uploadedById           String?
  uploadedBy             User?       @relation(fields: [uploadedById], references: [id])
  uploadedByPortalUserId String?
  uploadedByPortalUser   PortalUser? @relation(fields: [uploadedByPortalUserId], references: [id])
  // SHA-256 of the bytes: the same file is stored once per client.
  sha256                 String?
  // Bytes encrypted by the app (AES-256-GCM) before storage — identity documents.
  encrypted              Boolean     @default(false)
  createdAt              DateTime    @default(now())

  campaigns      Campaign[]
  consentRecords ConsentRecord[]
  document       Document?

  @@index([sha256])
}

// ---------------------------------------------------------------------------
// CAMPAIGNS
// ---------------------------------------------------------------------------

enum CampaignPurpose {
  // Appointment reminders, missing documents, deadlines — not promotional.
  SERVICE
  // Promotion of tax-preparation services.
  TAX_PREP_PROMO
  // Promotion of other services (bookkeeping, payroll, nonprofit, ...).
  OTHER_SERVICES_PROMO
  // Nonessential news: office hours, holiday closures, general announcements.
  // Not promotional, but honors the client's "General business updates" choice.
  GENERAL_UPDATE
}

enum CampaignChannel {
  EMAIL
  SMS
  BOTH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id           String          @id @default(cuid())
  title        String
  purpose      CampaignPurpose @default(SERVICE)
  channel      CampaignChannel @default(EMAIL)
  emailSubject String?
  // Plain text with light formatting (blank line = paragraph, **bold**).
  body         String          @default("")
  // Optional shorter text for SMS; falls back to `body`.
  smsBody      String?
  flyerId      String?
  flyer        StoredFile?     @relation(fields: [flyerId], references: [id], onDelete: SetNull)
  status       CampaignStatus  @default(DRAFT)
  scheduledAt  DateTime?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sentAt DateTime?

  groups     CampaignGroup[]
  inclusions CampaignInclusion[]
  exclusions CampaignExclusion[]
  messages   CampaignMessage[]
}

model CampaignGroup {
  campaignId String
  groupId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([campaignId, groupId])
}

// Individually selected clients.
model CampaignInclusion {
  campaignId String
  clientId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([campaignId, clientId])
}

// Campaign-only exclusions. They never touch group membership or the client
// record, and they survive changes to the campaign's audience selection.
model CampaignExclusion {
  campaignId String
  clientId   String
  reason     String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([campaignId, clientId])
}

// ---------------------------------------------------------------------------
// IMPORTS
// ---------------------------------------------------------------------------

enum ImportStatus {
  REVIEW
  COMMITTED
  DISCARDED
}

model ImportBatch {
  id                String       @id @default(cuid())
  source            String
  fileName          String
  status            ImportStatus @default(REVIEW)
  // Column mapping used (header -> CRM field). No cell data.
  mapping           Json
  updateMode        String       @default("fill_blanks")
  importedById      String
  importedBy        User         @relation(fields: [importedById], references: [id])
  createdAt         DateTime     @default(now())
  committedAt       DateTime?
  createdCount      Int          @default(0)
  updatedCount      Int          @default(0)
  skippedCount      Int          @default(0)
  errorCount        Int          @default(0)
  // Batch-wide options chosen in the wizard: services added to every row
  // (e.g. ["Tax Preparation"]) and the tax year return types belong to.
  batchServices     String[]     @default([])
  taxYear           Int?
  // Batch options: staff member to assign and groups to add for every client.
  batchAssignedToId String?
  batchGroupIds     String[]     @default([])
  // Completion summary: column names only (never cell data) — unmapped and
  // blocked columns, rows missing each field, and what needs attention.
  summary           Json?

  rows ImportRow[]
}

enum ImportMatch {
  NEW
  MATCH
  AMBIGUOUS
  ERROR
}

model ImportRow {
  id             String      @id @default(cuid())
  batchId        String
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  // Mapped, allow-listed fields only. Cleared after commit/discard.
  data           Json?
  errors         String[]
  warnings       String[]
  match          ImportMatch
  candidateIds   String[]
  // Staff decision: "create", "update:<clientId>", or "skip".
  decision       String?
  // Fields staff approved to REPLACE on the existing client after comparing
  // TaxAct with Client Connect. Blank fields are filled without this; values
  // already on file never change unless listed here.
  approvedFields String[]    @default([])
  resultClientId String?

  @@index([batchId, rowNumber])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Field names changed and non-sensitive context. Never raw import files.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ===========================================================================
// MULTI-FACTOR AUTHENTICATION
// ===========================================================================

model MfaRecoveryCode {
  id           String      @id @default(cuid())
  codeHash     String
  usedAt       DateTime?
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([portalUserId])
}

// ===========================================================================
// CLIENT PORTAL ACCOUNTS & ACCESS
// ===========================================================================
//
// Portal users are a separate identity type from staff. A portal user sees
// only the client records granted through PortalAccess — one owner can be
// granted several businesses, and a business can grant several people
// (each with their own login). Every portal query is scoped through
// PortalAccess on the server.

model PortalUser {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  phone                String?
  phoneNormalized      String?
  passwordHash         String?
  mfaSecretEnc         String?
  mfaEnabledAt         DateTime?
  mfaLastStep          Int?
  // Proven by entering a code emailed to this address (enables email codes).
  emailVerifiedAt      DateTime?
  // Resource Center: the state shown first (clients can switch anytime).
  preferredState       String?
  // Staff confirmed who this login belongs to (e.g. by phone or ID) when
  // the invitation link wasn't delivered by email. Either this or a proven
  // email address unlocks past-year tax records.
  identityVerifiedAt   DateTime?
  identityVerifiedById String?
  active               Boolean   @default(true)
  // Account-service notifications (new message / document / request).
  // Separate from marketing consent.
  notifyByEmail        Boolean   @default(true)
  notifyBySms          Boolean   @default(false)
  // Optional link to the CRM contact this login belongs to.
  contactId            String?   @unique
  contact              Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // "INVITED" (staff or activation invitation) or "SELF_SIGNUP".
  origin               String    @default("INVITED")
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  access         PortalAccess[]
  sessions       PortalSession[]
  resetTokens    PortalResetToken[]
  recoveryCodes  MfaRecoveryCode[]
  messages       Message[]              @relation("PortalMessages")
  trustedDevices TrustedDevice[]
  onboarding     OnboardingApplication?
  files          StoredFile[]
  documents      Document[]             @relation("PortalDocuments")
  notifications  Notification[]
  accessLogs     DocumentAccessLog[]
}

enum PortalRole {
  // Taxpayer / business owner
  OWNER
  // Authorized additional contact (bookkeeper, spouse, office manager…)
  AUTHORIZED_CONTACT
}

model PortalAccess {
  id                 String     @id @default(cuid())
  portalUserId       String
  portalUser         PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role               PortalRole @default(OWNER)
  canMessage         Boolean    @default(true)
  canUpload          Boolean    @default(true)
  // Per-login business view. Has no effect unless the client itself is a
  // Managed Business (Client.businessAccess = ACTIVE). Off by default.
  canViewBookkeeping Boolean    @default(false)
  canViewTax         Boolean    @default(true)
  canViewContracts   Boolean    @default(true)
  // Invoices and payment requests the owner explicitly published to this account.
  canViewBilling     Boolean    @default(true)
  // Identity documents (license, birth certificate, Social Security card).
  // On for owners, off for other authorized contacts unless granted.
  canViewIdentity    Boolean    @default(false)
  grantedById        String?
  createdAt          DateTime   @default(now())
  revokedAt          DateTime?

  @@unique([portalUserId, clientId])
  @@index([clientId])
}

model PortalInvite {
  id               String     @id @default(cuid())
  email            String
  name             String
  clientId         String
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role             PortalRole @default(OWNER)
  contactId        String?
  tokenHash        String     @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  // Null when sent by the system in answer to a client's activation request.
  invitedById      String?
  // True only when the link went out by email (activation); accepting it proves the address.
  sentByEmail      Boolean    @default(false)
  invitedBy        User?      @relation(fields: [invitedById], references: [id])
  // Activation email tracking: exact recipient, Resend's id, and what happened
  // (SENT = accepted by Resend; DELIVERED / FAILED only from signed Resend events).
  emailTo          String?
  emailProviderId  String?    @unique
  emailStatus      String?
  emailError       String?
  emailSentAt      DateTime?
  emailDeliveredAt DateTime?
  createdAt        DateTime   @default(now())

  @@index([email])
}

model PortalSession {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  mfaPassed    Boolean    @default(false)
  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())

  @@index([portalUserId])
}

model PortalResetToken {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}

// ===========================================================================
// CONVERSATIONS (unified: portal, email, text)
// ===========================================================================

enum MessageChannel {
  PORTAL
  EMAIL
  SMS
  // Staff-only note inside a conversation. Never shown to clients.
  INTERNAL_NOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  // Portal messages are delivered when saved.
  DELIVERED
  // Email/SMS lifecycle — only set from provider responses and webhooks.
  QUEUED
  PROVIDER_ACCEPTED
  FAILED
  BOUNCED
  UNSUBSCRIBED
  // Never used for real sends: demo/test mode only, always labeled.
  SIMULATED
}

model Conversation {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subject        String
  assignedToId   String?
  assignedTo     User?              @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Questions about a bookkeeping month attach to that period.
  periodId       String?
  period         BookkeepingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  // True when the newest message is from the client and nobody has replied.
  awaitingStaff  Boolean            @default(false)
  // Shared inbox: cleared when any staff member opens it.
  unreadByStaff  Boolean            @default(false)
  closedAt       DateTime?
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  // A question staff asked about a bookkeeping month: OPEN (unanswered) →
  // ANSWERED (client replied; staff to review) → RESOLVED. Null for ordinary threads.
  questionStatus String?
  responseDueAt  DateTime?
  askedById      String?
  resolvedAt     DateTime?
  resolvedById   String?

  messages Message[]

  @@index([clientId, lastMessageAt])
  @@index([awaitingStaff])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel        MessageChannel
  direction      MessageDirection
  body           String
  subject        String?
  staffAuthorId  String?
  staffAuthor    User?            @relation("StaffMessages", fields: [staffAuthorId], references: [id], onDelete: SetNull)
  portalAuthorId String?
  portalAuthor   PortalUser?      @relation("PortalMessages", fields: [portalAuthorId], references: [id], onDelete: SetNull)
  status         MessageStatus
  providerId     String?
  errorDetail    String?
  // Prevents duplicate sends when a request is retried.
  idempotencyKey String?          @unique
  readByClientAt DateTime?
  createdAt      DateTime         @default(now())

  attachments Document[] @relation("MessageAttachments")

  @@index([conversationId, createdAt])
}

// Outbox of "you have something new in your portal" notices. They contain a
// sign-in link only — never document contents or account details.
enum NotificationStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model Notification {
  id             String             @id @default(cuid())
  portalUserId   String
  portalUser     PortalUser         @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  channel        Channel
  kind           String
  status         NotificationStatus @default(PENDING)
  statusDetail   String?
  idempotencyKey String             @unique
  // Twilio Message SID (texts) — used by delivery-status callbacks.
  providerSid    String?            @unique
  // Latest provider delivery status, e.g. queued | sent | delivered | undelivered | failed
  deliveryStatus String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([status, createdAt])
}

// ===========================================================================
// DOCUMENT CENTER
// ===========================================================================

enum DocumentCategory {
  BOOKKEEPING
  TAXES
  CONTRACTS
  CLIENT_UPLOADS
  OTHER
  // Permanent identity documents (license, birth certificate, SS card).
  // Never listed with yearly folders; opened only through the Identity
  // Documents section by authorized staff and account holders.
  IDENTITY
}

enum DocumentVisibility {
  STAFF_ONLY
  PUBLISHED
}

enum ScanStatus {
  // No scanner configured — shown as "Not scanned" with a warning.
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
}

enum ReportType {
  PROFIT_AND_LOSS
  BALANCE_SHEET
  OTHER_REPORT
  GROSS_RECEIPTS
  BANK_RECONCILIATION
  SUPPORTING_SCHEDULE
  // A complete packet uploaded as one file (cover, statements, schedules).
  FINANCIAL_PACKET
}

model Document {
  id                 String             @id @default(cuid())
  // The client (person or business) this document belongs to.
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category           DocumentCategory
  title              String
  year               Int?
  month              Int?
  visibility         DocumentVisibility @default(STAFF_ONLY)
  publishedAt        DateTime?
  reportType         ReportType?
  fileId             String             @unique
  file               StoredFile         @relation(fields: [fileId], references: [id])
  scanStatus         ScanStatus         @default(NOT_SCANNED)
  uploadedByStaffId  String?
  uploadedByStaff    User?              @relation("StaffDocuments", fields: [uploadedByStaffId], references: [id], onDelete: SetNull)
  uploadedByPortalId String?
  uploadedByPortal   PortalUser?        @relation("PortalDocuments", fields: [uploadedByPortalId], references: [id], onDelete: SetNull)
  periodId           String?
  period             BookkeepingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  requestId          String?
  request            DocumentRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  retainUntil        DateTime?
  // Audited deletion: metadata is kept, the stored file is destroyed.
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?
  createdAt          DateTime           @default(now())

  messages               Message[]            @relation("MessageAttachments")
  accessLogs             DocumentAccessLog[]
  signaturePackages      SignatureRequest[]   @relation("SignaturePackage")
  signatureSigned        SignatureRequest[]   @relation("SignatureCompleted")
  signatureAudit         SignatureRequest[]   @relation("SignatureAuditTrail")
  contractPdfs           ContractAssignment[]
  // Acknowledgments, agency notices and correspondence for one filing.
  filingId               String?
  filing                 FilingRecord?        @relation(fields: [filingId], references: [id], onDelete: SetNull)
  // "OFFICIAL_ACK" | "AGENCY_NOTICE" | "CORRESPONDENCE" | "FIRM_SUMMARY"
  filingDocType          String?
  // Client uploads stay "Needs Review" until a staff member acknowledges them.
  needsReview            Boolean              @default(false)
  reviewedAt             DateTime?
  reviewedById           String?
  // Staff-chosen type for tax documents (return, TaxAct export, acceptance
  // notice, extension, amendment…). Informational only: it never changes a
  // filing's status or marks work complete.
  docType                String?
  // Bookkeeping reports (P&L, Balance Sheet…): DRAFT | AWAITING_REVIEW |
  // CHANGES_REQUESTED | APPROVED. Only the owner approves; a report reaches
  // the client (publish or message) only after approval.
  reviewStatus           String?
  reviewNote             String?
  submittedForReviewAt   DateTime?
  submittedForReviewById String?
  approvedAt             DateTime?
  approvedById           String?
  // Report versions: a revised report points at the version it replaces.
  // The old version is kept (history) and marked superseded; the client sees
  // the newest delivered version only.
  version                Int?
  replacesId             String?              @unique
  replaces               Document?            @relation("ReportVersions", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy             Document?            @relation("ReportVersions")
  supersededAt           DateTime?
  // Financial report details (bookkeeping): MONTH | QUARTER | YEAR_TO_DATE
  // (fiscal year start through the period month), the accounting basis
  // (CASH | ACCRUAL | MODIFIED_CASH), whether it shows year-to-date columns,
  // and the Balance Sheet "as of" date.
  reportPeriodType       String?
  reportBasis            String?
  reportIncludesYtd      Boolean?
  reportAsOf             DateTime?
  // What the document covers, when it's a date range (or a month/quarter
  // recorded on upload). Older documents keep whatever they had: nothing is guessed.
  periodStart            DateTime?
  periodEnd              DateTime?
  // A statement or reconciliation for one bank/card account.
  bookkeepingAccountId   String?
  // An audit or tax notice case this document belongs to.
  noticeCaseId           String?
  noticeCase             NoticeCase?          @relation(fields: [noticeCaseId], references: [id], onDelete: SetNull)
  // Malware-scan attempts: when the file was last checked, how many tries,
  // and why the last try didn't finish (scanner missing, no answer, rejected).
  scanAttempts           Int                  @default(0)
  lastScanAt             DateTime?
  lastScanError          String?
  bookkeepingAccount     BookkeepingAccount?  @relation(fields: [bookkeepingAccountId], references: [id], onDelete: SetNull)

  @@index([clientId, category, year, month])
  @@index([visibility])
}

model DocumentAccessLog {
  id           String      @id @default(cuid())
  documentId   String
  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action       String // VIEW | DOWNLOAD | UPLOAD | PUBLISH | UNPUBLISH | DELETE
  staffUserId  String?
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  ip           String?
  createdAt    DateTime    @default(now())

  @@index([documentId, createdAt])
}

model RetentionPolicy {
  category    DocumentCategory @id
  // Years to keep after upload. Null = keep until deleted manually.
  years       Int?
  updatedAt   DateTime         @updatedAt
  updatedById String?
}

// ===========================================================================
// BOOKKEEPING WORKSPACES
// ===========================================================================

enum PeriodStatus {
  AWAITING_DOCUMENTS
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETE
}

/// A revised completion estimate for a bookkeeping month. The original target
/// (the 15th, or the client's agreed day) is never overwritten.
model PeriodTargetRevision {
  id          String            @id @default(cuid())
  periodId    String
  period      BookkeepingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  targetOn    DateTime
  reason      String
  createdById String
  createdAt   DateTime          @default(now())

  @@index([periodId])
}

model BookkeepingPeriod {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  status      PeriodStatus @default(AWAITING_DOCUMENTS)
  staffNote   String?
  updatedById String?
  updatedBy   User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  documents       Document[]
  requests        DocumentRequest[]
  conversations   Conversation[]
  checklist       BookkeepingChecklistItem[]
  targetRevisions PeriodTargetRevision[]

  @@unique([clientId, year, month])
}

enum RequestStatus {
  OPEN
  SUBMITTED
  ACCEPTED
  CANCELLED
}

model DocumentRequest {
  id           String             @id @default(cuid())
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodId     String?
  period       BookkeepingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  title        String
  instructions String?
  category     DocumentCategory   @default(CLIENT_UPLOADS)
  dueAt        DateTime?
  remindAt     DateTime?
  status       RequestStatus      @default(OPEN)
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  documents Document[]

  @@index([clientId, status])
}

// ===========================================================================
// UPDATES, ANNOUNCEMENTS & DEADLINES
// ===========================================================================

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  // Set = client-specific update; null = announcement to the groups below.
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // A future time schedules the announcement.
  publishedAt DateTime?
  expiresAt   DateTime?
  // "ALL" | "INDIVIDUAL" | "BUSINESS" | "BOOKKEEPING"; null = the groups below.
  audience    String?
  // TAX_SEASON | DOCUMENT_TIPS | OFFICE_HOURS | HOLIDAY | SERVICE | DEADLINE | GENERAL
  topic       String?
  pinned      Boolean   @default(false)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  groups AnnouncementGroup[]
}

// Official tax dates shown in the client countdowns. Only rows with a
// source link and a review date are shown to clients.
model TaxDeadline {
  id             String    @id @default(cuid())
  // See src/lib/tax/deadlines.ts (TAX_SEASON_OPENS, INDIVIDUAL, PARTNERSHIP,
  // S_CORP, C_CORP, and their *_EXTENDED forms).
  kind           String
  // The tax year the return covers (2026 returns are due in 2027).
  taxYear        Int
  // Whose deadline: "US" (IRS) or a state code.
  jurisdiction   String    @default("US")
  // Set on an IRS row that replaces the general date only for clients in
  // that state (disaster relief). "" = applies everywhere.
  reliefState    String    @default("")
  // Calendar date, YYYY-MM-DD (date-only, never shifted by time zone).
  dueDate        String
  timeNote       String?
  notes          String?
  sourceUrl      String?
  lastReviewedAt DateTime?
  reviewedById   String?
  hidden         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([kind, taxYear, jurisdiction, reliefState])
}

// ===========================================================================
// MY TAX CENTER
// ===========================================================================

// The Jotform tax questionnaire for one tax year (and audience).
model TaxQuestionnaire {
  id            String   @id @default(cuid())
  taxYear       Int
  // "ALL" | "INDIVIDUAL" | "BUSINESS"
  audience      String   @default("ALL")
  title         String
  // Numeric Jotform form ID from the owner. Null = not set up yet.
  jotformFormId String?
  active        Boolean  @default(true)
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions QuestionnaireSubmission[]

  @@unique([taxYear, audience])
}

// A completed questionnaire linked to one client and tax year, either
// reported by Jotform (verified through the API) or imported by staff after
// they confirmed the client match.
model QuestionnaireSubmission {
  id              String            @id @default(cuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxYear         Int
  questionnaireId String?
  questionnaire   TaxQuestionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  jotformFormId   String
  submissionId    String            @unique
  submittedAt     DateTime?
  // "jotform_webhook" | "staff_import" | "staff_verified"
  source          String
  // Encrypted question/answer pairs (staff only).
  answersEnc      String?
  // How the client match was confirmed.
  matchNote       String?
  linkedById      String?
  documentIds     String[]
  // Staff review before anything in the answers changes the client record.
  // NEEDS_REVIEW | REVIEWED
  reviewStatus    String            @default("NEEDS_REVIEW")
  reviewedAt      DateTime?
  reviewedById    String?
  // Client fields staff chose to update from the answers (names only).
  appliedFields   String[]          @default([])
  // Coetha's follow-up checklist (draft for staff review): [{label, reason, status}]
  followUp        Json?
  createdAt       DateTime          @default(now())

  @@index([clientId, taxYear])
}

// A tax questionnaire sent to (or opened by) a client for one tax year.
// One row per client per year: resending updates it, never duplicates it.
model QuestionnaireRequest {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxYear         Int
  questionnaireId String?
  // Staff send (null when the client opened it from the portal on their own).
  sentAt          DateTime?
  sentById        String?
  // Recipient address at send time.
  sentTo          String?
  sendCount       Int       @default(0)
  // First time the client opened the form from the portal.
  openedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([clientId, taxYear])
}

// Staff-entered progress for one client and tax year. Questionnaire,
// documents, preparation, filing and agency acceptance are separate.
model TaxYearProgress {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxYear             Int
  // NOT_STARTED | SOME_RECEIVED | ALL_RECEIVED
  documentsStatus     String    @default("NOT_STARTED")
  documentsUpdatedAt  DateTime?
  estimatedCompletion DateTime?
  estimateNote        String?
  updatedById         String?
  updatedAt           DateTime  @updatedAt

  @@unique([clientId, taxYear])
}

model AnnouncementGroup {
  announcementId String
  groupId        String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([announcementId, groupId])
}

model ClientDeadline {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  dueAt           DateTime
  visibleToClient Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())

  @@index([clientId, dueAt])
}

// ===========================================================================
// TAX SIGNATURES (provider-backed) & CONTRACTS (Jotform)
// ===========================================================================

enum SignatureStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_SIGNED
  COMPLETED
  DECLINED
  EXPIRED
  // Signed outside the app; staff uploaded the signed copy. Never shown as
  // an electronic signature collected through the app.
  SIGNED_OFFLINE_UPLOADED
}

model SignatureRequest {
  id                   String          @id @default(cuid())
  clientId             String
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title                String
  taxYear              Int?
  status               SignatureStatus @default(DRAFT)
  // Null until a verified signing provider is configured.
  provider             String?
  providerEnvelopeId   String?         @unique
  packageDocumentId    String?
  packageDocument      Document?       @relation("SignaturePackage", fields: [packageDocumentId], references: [id], onDelete: SetNull)
  signedDocumentId     String?
  signedDocument       Document?       @relation("SignatureCompleted", fields: [signedDocumentId], references: [id], onDelete: SetNull)
  auditTrailDocumentId String?
  auditTrailDocument   Document?       @relation("SignatureAuditTrail", fields: [auditTrailDocumentId], references: [id], onDelete: SetNull)
  sentAt               DateTime?
  completedAt          DateTime?
  expiresAt            DateTime?
  createdById          String
  createdBy            User            @relation(fields: [createdById], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  signers SignatureSigner[]

  @@index([clientId, status])
}

model SignatureSigner {
  id        String           @id @default(cuid())
  requestId String
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  // TAXPAYER | SPOUSE | OFFICER | OTHER
  role      String
  status    String           @default("PENDING")
  signedAt  DateTime?
  order     Int              @default(1)
}

enum ContractStatus {
  ASSIGNED
  // Jotform reported a submission (verified via API/webhook).
  SUBMITTED
  COMPLETED
  CANCELLED
}

model ContractAssignment {
  id               String         @id @default(cuid())
  // The person or business this contract is for.
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title            String
  jotformFormId    String
  status           ContractStatus @default(ASSIGNED)
  submissionId     String?        @unique
  submittedAt      DateTime?
  // How completion was confirmed: "jotform_webhook" | "jotform_api" | "staff_verified"
  completionSource String?
  pdfDocumentId    String?
  pdfDocument      Document?      @relation(fields: [pdfDocumentId], references: [id], onDelete: SetNull)
  dueAt            DateTime?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clientId, status])
}

// ===========================================================================
// CALENDAR
// ===========================================================================

enum AppointmentStatus {
  // Booked by a client, waiting for the owner's approval. Holds its slot.
  REQUESTED
  CONFIRMED
  // The client asked for a new time; the old slot and the requested one are both held.
  RESCHEDULE_REQUESTED
  // The owner proposed a different time; the client accepts or declines it.
  PROPOSED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// One appointment for one client (the master Client record). Staff-created
// appointments (Tasks & Calendar) and portal bookings share this table, so the
// same row shows on the client's Upcoming Appointments, the staff and owner
// calendars and the client profile.
model Appointment {
  id                   String            @id @default(cuid())
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                String
  startsAt             DateTime
  endsAt               DateTime?
  durationMin          Int?
  location             String?
  staffId              String?
  // Kept in step with status = CANCELLED for older callers.
  cancelledAt          DateTime?
  createdById          String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  status               AppointmentStatus @default(CONFIRMED)
  // "STAFF" (added by staff) or "PORTAL" (booked by the client).
  source               String            @default("STAFF")
  // Service keys from src/lib/appointments/services.ts.
  services             String[]
  // IN_OFFICE | PHONE | VIRTUAL
  meetingType          String?
  clientNotes          String?
  // Never shown to the client.
  staffNotes           String?
  bookedByPortalUserId String?
  // Snapshot of the Booking Information step (name, phone, email, new/existing,
  // business name, text consent). Changes there never overwrite the master record.
  bookingInfo          Json?
  // Text consent given for this appointment (appointment/service texts only).
  smsOptIn             Boolean           @default(false)
  // Bumped whenever the time is confirmed again, so each confirmation is sent once per version.
  version              Int               @default(1)
  confirmedAt          DateTime?
  // A requested (client) or proposed (owner) new time.
  pendingStartsAt      DateTime?
  pendingEndsAt        DateTime?
  pendingStaffId       String?
  pendingBy            String?

  events  AppointmentEvent[]
  notices AppointmentNotice[]
  claims  AppointmentSlotClaim[]

  @@index([startsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
}

// Database guard against double-booking: every 15-minute block an active
// appointment occupies is claimed once per staff member.
model AppointmentSlotClaim {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  staffId       String
  blockStart    DateTime
  // CURRENT (the booked time) or PENDING (a requested / proposed new time).
  kind          String      @default("CURRENT")

  @@unique([staffId, blockStart])
  @@index([appointmentId])
}

// Creation and modification history.
model AppointmentEvent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  action        String
  // CLIENT | STAFF | SYSTEM
  actorType     String
  actorId       String?
  fromStatus    String?
  toStatus      String?
  details       Json?
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

// Confirmation, reminder, cancellation and owner-alert history (sent / skipped / failed).
model AppointmentNotice {
  id             String      @id @default(cuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  // CLIENT or OWNER
  audience       String
  // EMAIL or SMS
  channel        String
  // REQUEST_RECEIVED | CONFIRMATION | RESCHEDULED | PROPOSED | DECLINED | CANCELLED | REMINDER_24H | REMINDER_2H | OWNER_* alerts
  kind           String
  version        Int
  to             String?
  subject        String?
  body           String      @default("")
  // PENDING | SENT | SKIPPED | FAILED
  status         String      @default("PENDING")
  statusDetail   String?
  providerSid    String?     @unique
  deliveryStatus String?
  notBefore      DateTime    @default(now())
  sentAt         DateTime?
  // appointment + kind + version + audience + channel: never sent twice.
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())

  @@index([status, notBefore])
  @@index([appointmentId, createdAt])
}

// Office-wide booking rules (one row, id "default"). Owner only.
model AppointmentSettings {
  id                      String   @id @default("default")
  // ISO weekdays 1 = Monday … 7 = Sunday; copied into each month when it is first opened.
  weekdays                Int[]    @default([1, 2, 3, 4, 5])
  openTime                String   @default("09:00")
  closeTime               String   @default("17:00")
  slotStepMin             Int      @default(30)
  maxPerDay               Int      @default(6)
  // Earliest a client may book, in hours from now.
  minNoticeHours          Int      @default(24)
  // Clients may cancel or reschedule online until this many hours before.
  cancelCutoffHours       Int      @default(24)
  rescheduleNeedsApproval Boolean  @default(true)
  // Every new booking waits for the owner's approval (holding its slot).
  requireApproval         Boolean  @default(true)
  meetingTypes            String[] @default(["IN_OFFICE", "PHONE", "VIRTUAL"])
  alertEmail              String   @default("info@tturnerassociates.com")
  // E.164. Owner booking alerts; texts go out only through the staff-alert texting path when it is on.
  alertPhone              String   @default("+12054201825")
  remind24h               Boolean  @default(true)
  remind2h                Boolean  @default(true)
  updatedById             String?
  updatedAt               DateTime @default(now()) @updatedAt
}

// A month opened by the owner. Nothing in a month is bookable until it is published.
model AppointmentMonth {
  id            String    @id @default(cuid())
  year          Int
  month         Int
  weekdays      Int[]
  openTime      String
  closeTime     String
  maxPerDay     Int
  publishedAt   DateTime?
  publishedById String?
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([year, month])
}

// Blocks (holidays, vacation, personal days, closures, single dates or time
// ranges) and special availability for specific dates.
model AppointmentDateRule {
  id          String   @id @default(cuid())
  // "YYYY-MM-DD" in office (Central) time
  date        String
  // BLOCK or SPECIAL
  kind        String
  // HOLIDAY | VACATION | PERSONAL | CLOSURE | OTHER (blocks)
  reason      String?
  label       String?
  // "HH:MM"; both null = the whole day
  startTime   String?
  endTime     String?
  // null = the whole office; otherwise one staff member
  staffId     String?
  // SPECIAL only: the day's own appointment limit
  maxPerDay   Int?
  createdById String
  createdAt   DateTime @default(now())

  @@index([date])
}

// Staff who take client appointments and when. With none set up, the owner takes every booking.
model AppointmentStaff {
  id        String   @id @default(cuid())
  userId    String   @unique
  active    Boolean  @default(true)
  weekdays  Int[]    @default([1, 2, 3, 4, 5])
  // null = office hours
  startTime String?
  endTime   String?
  sortOrder Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

// ===========================================================================
// WORKFLOWS: PIPELINES & AUTOMATIONS
// ===========================================================================
//
// Prospect pipeline stages are configurable and cards are stored here.
// Bookkeeping and Tax boards are views over BookkeepingPeriod.status and
// FilingRecord.prepStatus so there is a single source of truth.

model PipelineStage {
  id        String   @id @default(cuid())
  pipeline  String // "PROSPECTS"
  name      String
  position  Int
  // Moving a card here marks the client Active (e.g. "Active Client").
  isWon     Boolean  @default(false)
  createdAt DateTime @default(now())

  cards PipelineCard[]

  @@index([pipeline, position])
}

model PipelineCard {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stageId   String
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  note      String?
  ownerId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([clientId, stageId])
  @@index([stageId])
}

enum AutomationKind {
  MISSING_DOCUMENT_REMINDER
  APPOINTMENT_REMINDER
  CONTRACT_FOLLOW_UP
}

model AutomationRule {
  id              String         @id @default(cuid())
  kind            AutomationKind @unique
  name            String
  // Paused rules don't run; nothing is sent while paused.
  enabled         Boolean        @default(false)
  // Days relative to the due date / appointment (negative = before).
  offsetDays      Int
  // Minimum days between reminders for the same item.
  repeatEveryDays Int?
  maxReminders    Int            @default(3)
  updatedById     String?
  updatedAt       DateTime       @updatedAt

  runs AutomationRun[]
}

model AutomationRun {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // The item reminded about, e.g. "request:<id>"
  targetKey String
  clientId  String?
  // Unique per rule + item + reminder number: retries can't duplicate.
  dedupeKey String         @unique
  outcome   String // "QUEUED" | "SKIPPED:<reason>" | "CANCELLED"
  createdAt DateTime       @default(now())

  @@index([ruleId, createdAt])
}

// ===========================================================================
// TAX WORKSPACE
// ===========================================================================
//
// One FilingRecord per client + tax year + return type + jurisdiction +
// filing type. Preparation status (internal) and filing status (e-file
// acknowledgment) are separate fields with separate histories, and federal
// and state filings are separate records, so one never changes the other.

enum FilingType {
  ORIGINAL
  EXTENSION
  AMENDED
}

enum PrepStatus {
  AWAITING_INFORMATION
  IN_PROGRESS
  UNDER_REVIEW
  AWAITING_SIGNATURE
  READY_TO_FILE
}

enum FilingStatus {
  NOT_SUBMITTED
  SUBMITTED
  PENDING_ACKNOWLEDGMENT
  ACCEPTED
  REJECTED
}

enum FilingMethod {
  ELECTRONIC
  PAPER
}

// What happened after an amended return was accepted for processing.
enum AmendmentOutcome {
  NONE
  PROCESSING
  PROCESSING_COMPLETE
  CHANGES_APPROVED
  CHANGES_ADJUSTED
  REFUND_ISSUED
  BALANCE_DUE_NOTICE
}

enum StatusSource {
  STAFF
  TAXACT_IMPORT
}

model FilingRecord {
  id               String           @id @default(cuid())
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxYear          Int
  // e.g. 1040, 1120-S, 1065, 990, 1041, 1120
  returnType       String
  // "FEDERAL" or a two-letter state code
  jurisdiction     String
  filingType       FilingType       @default(ORIGINAL)
  method           FilingMethod     @default(ELECTRONIC)
  prepStatus       PrepStatus       @default(AWAITING_INFORMATION)
  filingStatus     FilingStatus     @default(NOT_SUBMITTED)
  amendmentOutcome AmendmentOutcome @default(NONE)
  submittedAt      DateTime?
  acknowledgedAt   DateTime?
  // Submission ID / DCN when the source provides it.
  filingReference  String?
  rejectionCodes   String?
  statusSource     StatusSource?
  // Time of the source event behind the current filing status; older
  // imports never overwrite a newer verified status.
  statusAsOf       DateTime?
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  // Visible in the client's portal tax view.
  visibleToClient  Boolean          @default(true)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  events     FilingStatusEvent[]
  documents  Document[]
  importRows TaxImportRow[]

  @@unique([clientId, taxYear, returnType, jurisdiction, filingType])
  @@index([filingStatus])
  @@index([prepStatus])
}

model FilingStatusEvent {
  id                 String       @id @default(cuid())
  filingId           String
  filing             FilingRecord @relation(fields: [filingId], references: [id], onDelete: Cascade)
  // "PREP" or "FILING" or "AMENDMENT"
  field              String
  fromValue          String?
  toValue            String
  source             StatusSource
  actorId            String?
  importBatchId      String?
  // Required to record ACCEPTED: an acknowledgment document or a note of how staff verified it.
  evidenceDocumentId String?
  verificationNote   String?
  eventAt            DateTime
  createdAt          DateTime     @default(now())

  @@index([filingId, createdAt])
}

model TaxImportBatch {
  id           String       @id @default(cuid())
  source       String // e.g. "TaxAct Professional — E-file Details report"
  fileName     String
  mapping      Json
  // Which statuses staff chose to import, e.g. ["ACCEPTED"]
  statusFilter String[]
  status       ImportStatus @default(REVIEW)
  importedById String
  createdAt    DateTime     @default(now())
  committedAt  DateTime?
  appliedCount Int          @default(0)
  skippedCount Int          @default(0)

  rows TaxImportRow[]
}

model TaxImportRow {
  id        String         @id @default(cuid())
  batchId   String
  batch     TaxImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  // Mapped fields only (no SSN/EIN). Cleared after commit.
  data      Json?
  errors    String[]
  warnings  String[]
  // "MATCH" | "NEW_FILING" | "AMBIGUOUS" | "NO_CLIENT" | "STALE" | "FILTERED" | "ERROR"
  match     String
  clientId  String?
  filingId  String?
  filing    FilingRecord?  @relation(fields: [filingId], references: [id], onDelete: SetNull)
  decision  String? // "apply" | "skip"
  applied   Boolean        @default(false)

  @@index([batchId, rowNumber])
}

// ===========================================================================
// SOCIAL MEDIA
// ===========================================================================
//
// Uses the marketing media library (StoredFile kind FLYER), which is kept
// apart from client/tax documents. Direct publishing is off until a platform
// account is connected through its official authorization flow and approved;
// until then targets become "Requires manual posting" at their scheduled time
// and only a staff confirmation (with the post link) marks them posted.

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SocialTargetStatus {
  DRAFT
  SCHEDULED
  // Direct publishing only — set from the platform's API response.
  PUBLISHED
  FAILED
  REQUIRES_MANUAL_POSTING
  // Staff confirmed they posted it by hand (with the post link).
  POSTED_MANUALLY
  CANCELLED
}

model SocialPost {
  id                 String           @id @default(cuid())
  title              String
  status             SocialPostStatus @default(DRAFT)
  scheduledAt        DateTime?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  approvalNote       String?
  // Set only when the approver confirmed flagged, time-sensitive claims; cleared on any edit.
  claimsVerifiedAt   DateTime?
  claimsVerifiedById String?
  // Suggested from an approved content topic (built-in generator).
  topicId            String?
  topic              ContentTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  // Which caption variant was generated last (regenerate rotates it).
  generatorVariant   Int              @default(0)
  // The planned time came from the recommendation helper, not analytics.
  timeSuggested      Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  targets   SocialPostTarget[]
  revisions SocialPostRevision[]

  @@index([scheduledAt])
  @@index([topicId])
}

// Edit history: every save, approval decision, schedule change and posting.
model SocialPostRevision {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  snapshot  Json
  createdAt DateTime   @default(now())

  @@index([postId, createdAt])
}

enum ContentCategory {
  SERVICE
  TAX_SEASON
  BOOKKEEPING_TIP
  BUSINESS_SETUP
  NONPROFIT
  OFFICE_ANNOUNCEMENT
  HOLIDAY
}

// Approved talking points the suggestion helper may use. Suggestions never
// add facts beyond these — no invented prices, promotions, deadlines,
// testimonials or hours.
model ContentTopic {
  id           String          @id @default(cuid())
  category     ContentCategory
  title        String
  keyMessage   String
  callToAction String?
  hashtags     String[]
  // For holidays/announcements: the date entered by staff (never invented).
  eventDate    DateTime?       @db.Date
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  posts SocialPost[]
}

model SocialPostTarget {
  id             String             @id @default(cuid())
  postId         String
  post           SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  caption        String             @default("")
  // Kept separate so "Copy caption & hashtags" and the hashtag limits work.
  hashtags       String[]           @default([])
  // Ordered StoredFile ids from the media library.
  mediaIds       String[]
  status         SocialTargetStatus @default(DRAFT)
  // "DIRECT" only when a connected, approved account exists.
  publishMode    String             @default("MANUAL")
  // Prevents a retry from publishing twice.
  idempotencyKey String             @unique @default(cuid())
  externalPostId String?
  permalink      String?
  errorDetail    String?
  publishedAt    DateTime?
  confirmedById  String?
  // Set once when the post becomes due — one reminder per platform, never repeated.
  reminderAt     DateTime?
  updatedAt      DateTime           @updatedAt

  @@unique([postId, platform])
  @@index([status])
}

model SocialAccount {
  id             String         @id @default(cuid())
  platform       SocialPlatform
  accountName    String
  externalId     String
  // Encrypted with APP_ENCRYPTION_KEY; never sent to the browser.
  tokenEnc       String
  scopes         String[]
  // Platform approval state for direct publishing, e.g. "app_review_approved".
  approvalState  String?
  connectedById  String
  connectedAt    DateTime       @default(now())
  disconnectedAt DateTime?

  @@unique([platform, externalId])
}

// ===========================================================================
// SMS CONSENT LEDGER & INBOUND TEXTS
// ===========================================================================
//
// Phone-level, category-specific text permissions. The newest event per
// phone + category is the current state. Every SMS send checks this ledger
// (plus Suppression) on the server. Imports never write here.

enum SmsConsentCategory {
  SERVICE
  MARKETING
}

model SmsConsentSubmission {
  id               String   @id @default(cuid())
  name             String
  phoneNormalized  String
  serviceOptIn     Boolean
  marketingOptIn   Boolean
  consentVersion   String
  // Exact wording displayed next to each checkbox at the time of submission.
  serviceText      String
  marketingText    String
  sourcePage       String
  // Hashed (keyed) client IP for abuse prevention — the raw IP is not stored.
  ipHash           String?
  userAgent        String?
  matchedClientIds String[]
  createdAt        DateTime @default(now())

  @@index([phoneNormalized, createdAt])
  @@index([createdAt])
}

model SmsConsentEvent {
  id              String             @id @default(cuid())
  phoneNormalized String
  category        SmsConsentCategory
  status          ConsentStatus
  // WEB_FORM | STOP_KEYWORD | START_KEYWORD | CLIENT_PORTAL | STAFF
  source          String
  sourcePage      String?
  consentVersion  String?
  consentText     String?
  submissionId    String?
  inboundSmsId    String?
  actorId         String?
  createdAt       DateTime           @default(now())

  @@index([phoneNormalized, category, createdAt])
}

model InboundSms {
  id              String   @id @default(cuid())
  providerSid     String   @unique
  fromNormalized  String
  toNumber        String?
  body            String
  // STOP | START | HELP | null
  keyword         String?
  matchedClientId String?
  conversationId  String?
  receivedAt      DateTime @default(now())

  @@index([fromNormalized, receivedAt])
}

// ===========================================================================
// OWNER'S OFFICE — private to the owner's own staff account.
// Nothing here is reachable from staff pages, search, reports, exports, the
// shared audit log or the general file route. Access is bound to a User ID.
// ===========================================================================

model OwnerAccess {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation("OwnerAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  // The owner's own binding. Only the primary may grant or revoke others.
  isPrimary   Boolean    @default(false)
  // FULL = the whole Owner's Office; BILLING = quotes, invoices and payments only
  // (no expenses, no financial dashboard, no settings).
  scope       OwnerScope @default(FULL)
  grantedById String?
  grantedAt   DateTime   @default(now())
  revokedAt   DateTime?
}

enum OwnerScope {
  FULL
  BILLING
}

// Separate from the shared AuditLog so staff Admins can't see owner activity.
model OwnerAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum InvoiceState {
  DRAFT
  // Published to the client for acceptance (a quote).
  OFFERED
  // The client accepted the terms; the schedule is fixed.
  ACCEPTED
  // Published as an invoice with no acceptance step.
  ISSUED
  DECLINED
  VOID
  // Submitted by authorized staff; waits for the owner to approve and send.
  PENDING_APPROVAL
}

enum AmountType {
  NONE
  FLAT
  PERCENT
}

enum PaymentOption {
  FULL
  PLAN
}

// One itemized quote / invoice. Prices, discounts and fees are owner-only.
model Invoice {
  id                    String         @id @default(cuid())
  number                String         @unique
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  state                 InvoiceState   @default(DRAFT)
  title                 String
  issueDate             DateTime       @db.Date
  // Full-payment due date (balance after any deposit).
  dueDate               DateTime       @db.Date
  // Shown to the client.
  memo                  String?
  paymentTerms          String?
  // Owner-only.
  privateNote           String?
  allowFull             Boolean        @default(true)
  allowPlan             Boolean        @default(false)
  // Deposit: FLAT = cents, PERCENT = basis points of the chosen option's total.
  depositType           AmountType     @default(NONE)
  depositValue          Int            @default(0)
  // Discount on services (and optionally the plan fee). FLAT = cents, PERCENT = basis points.
  discountType          AmountType     @default(NONE)
  discountValue         Int            @default(0)
  discountCoversPlanFee Boolean        @default(false)
  // Sales tax on services after discount, basis points (e.g. 400 = 4%).
  taxRateBps            Int            @default(0)
  // Payment-plan fee, copied from Billing settings when the quote is made.
  planFeeType           AmountType     @default(NONE)
  planFeeValue          Int            @default(0)
  planInstallments      Int            @default(3)
  planFirstDueDate      DateTime?      @db.Date
  planIntervalMonths    Int            @default(1)
  publishedAt           DateTime?
  // Acceptance — the exact terms the client saw, frozen.
  acceptedOption        PaymentOption?
  acceptedAt            DateTime?
  acceptedByPortalId    String?
  acceptedTerms         Json?
  acceptedTermsHash     String?
  acceptedFromIp        String?
  declinedAt            DateTime?
  voidedAt              DateTime?
  voidReason            String?
  // The one payment method selected for this invoice (changes need owner approval; see PaymentMethodChange).
  paymentMethod         String?
  // "QUOTE" = itemized quote form; "INVOICE" = Create Invoice (one service, staff-chosen payment options).
  formType              String         @default("QUOTE")
  // Billing contact copied from the master client record when the invoice is created or edited.
  billingName           String?
  billingEmail          String?
  billingPhone          String?
  billingAddress        String?
  // Payment methods staff offered on this invoice. Only methods the owner approved
  // (an active PaymentInstruction) can be offered; the client sees only these.
  offeredMethods        String[]       @default([])
  // A Square payment link created in the firm's own Square account. Shown to the client only
  // when the owner has enabled Square payment links (BillingSettings) and Square is configured.
  squarePaymentUrl      String?
  // Sent through the firm's existing Square connection (Orders + Invoices API). Square's ids are
  // stored so retries resume instead of creating a second order or invoice. public_url is the
  // page the client pays on ("Pay securely with Square").
  squareCustomerId      String?
  squareOrderId         String?        @unique
  squareInvoiceId       String?        @unique
  squareInvoiceVersion  Int?
  // Square's invoice status: DRAFT, UNPAID, SCHEDULED, PARTIALLY_PAID, PAID, CANCELED, ...
  squareStatus          String?
  squarePublicUrl       String?
  // Part of every Square idempotency key; only changes if a canceled Square invoice is replaced.
  squareRevision        Int            @default(1)
  squareSentAt          DateTime?
  squareSentById        String?
  squareSyncedAt        DateTime?
  // The last Square problem for this invoice, in plain language (never a token or card data).
  squareError           String?
  // Our branded email with the Square link (delivery "Share manually").
  squareEmailSentAt     DateTime?
  submittedAt           DateTime?
  submittedById         String?
  approvedAt            DateTime?
  approvedById          String?
  // First time the client opened the sent invoice in the portal.
  viewedAt              DateTime?
  createdById           String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  lines        InvoiceLine[]
  payments     Payment[]
  installments Installment[]

  @@index([clientId, state])
  @@index([issueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     String
  description String?
  quantity    Int     @default(1)
  // Money is stored in cents.
  unitCents   Int
  sortOrder   Int     @default(0)
}

// Fixed when the client accepts (or the invoice is issued).
model Installment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  seq         Int
  label       String
  dueDate     DateTime @db.Date
  amountCents Int

  @@unique([invoiceId, seq])
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  ZELLE
  CASH_APP
  OTHER
  VENMO
  // Republic Bank Refund Transfer deposit.
  REFUND_TRANSFER
}

enum PaymentKind {
  PAYMENT
  REFUND
  // An owner-approved balance adjustment (credit). Not cash: never counted as collected revenue.
  CREDIT
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
}

// Money movements. Only SUCCEEDED payments (minus refunds) count as collected.
model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  kind           PaymentKind   @default(PAYMENT)
  status         PaymentStatus @default(SUCCEEDED)
  amountCents    Int
  receivedOn     DateTime      @db.Date
  method         PaymentMethod
  // "manual" until a payment provider is connected; then the provider's name.
  source         String        @default("manual")
  providerRef    String?       @unique
  reference      String?
  note           String?
  failureNote    String?
  // The form's one-time key: a double-submitted form can't record the same payment twice.
  idempotencyKey String?       @unique
  createdById    String
  createdAt      DateTime      @default(now())

  @@index([receivedOn])
  @@index([invoiceId])
}

// Owner-configurable defaults. One row (id = "default").
model BillingSettings {
  id                       String     @id @default("default")
  planFeeType              AmountType @default(NONE)
  planFeeValue             Int        @default(0)
  maxInstallments          Int        @default(4)
  defaultInstallments      Int        @default(3)
  defaultDiscountType      AmountType @default(NONE)
  defaultDiscountValue     Int        @default(0)
  defaultTaxRateBps        Int        @default(0)
  defaultDepositType       AmountType @default(NONE)
  defaultDepositValue      Int        @default(0)
  defaultPaymentTerms      String?
  // Owner confirmed the payment provider's / legal rules for the plan fee.
  planFeeRulesConfirmedAt  DateTime?
  // Square payment links on invoices: off until the owner turns them on.
  squareLinksEnabledAt     DateTime?
  squareLinksEnabledById   String?
  // Republic Bank Refund Transfer fees the owner has confirmed, shown to clients as written.
  // Empty = no fee amounts are shown (none are assumed).
  refundTransferFeeNote    String?
  // "Send invoices through Square": the one owner-only switch for live Square invoices. Off until
  // the owner turns it on; every change is in the owner audit log.
  squareSendingEnabledAt   DateTime?
  squareSendingEnabledById String?
  // SHARE_MANUALLY = our own branded email carries the Square link; EMAIL = Square emails the client.
  squareDelivery           String     @default("SHARE_MANUALLY")
  // Bank transfer (ACH) on Square invoices, alongside card.
  squareAcceptBank         Boolean    @default(true)
  updatedById              String?
  updatedAt                DateTime   @updatedAt
}

model Expense {
  id          String         @id @default(cuid())
  spentOn     DateTime       @db.Date
  vendor      String
  category    String
  amountCents Int
  method      PaymentMethod?
  note        String?
  receiptKey  String?        @unique
  receiptName String?
  receiptMime String?
  createdById String
  createdAt   DateTime       @default(now())
  deletedAt   DateTime?

  @@index([spentOn])
}

// ===========================================================================
// SIGN-IN VERIFICATION CODES & RECOVERY
// ===========================================================================

enum ChallengePurpose {
  // Second factor at sign-in.
  SIGN_IN
  // Proving the account's email address (turns on email codes).
  VERIFY_EMAIL
}

// One emailed (or, later, texted) code. Single use, short-lived, limited attempts.
model MfaChallenge {
  id          String           @id @default(cuid())
  subjectKind String
  subjectId   String
  purpose     ChallengePurpose
  channel     String
  destination String
  codeHash    String
  expiresAt   DateTime
  attempts    Int              @default(0)
  consumedAt  DateTime?
  // Set only when the provider accepted the message.
  sentAt      DateTime?
  providerId  String?
  sendError   String?
  createdAt   DateTime         @default(now())

  @@index([subjectKind, subjectId, createdAt])
}

// Client sign-in by emailed code is switched on only after email delivery was
// proven (an Admin received a test code and entered it) and an Admin enabled it.
model AuthSettings {
  id                      String    @id @default("default")
  clientEmailCodes        Boolean   @default(false)
  emailDeliveryVerifiedAt DateTime?
  emailDeliveryVerifiedBy String?
  enabledById             String?
  enabledAt               DateTime?
  trustedDeviceDays       Int       @default(30)
  updatedAt               DateTime  @updatedAt
}

// "Remember this device" for clients: skips the emailed code on this browser
// until it expires or is revoked. Only the hash of the cookie is stored.
model TrustedDevice {
  id           String     @id @default(cuid())
  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  label        String
  createdAt    DateTime   @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@index([portalUserId])
}

// Owner recovery codes (set in Netlify) are single use.
model UsedRecoveryToken {
  tokenHash String   @id
  userId    String
  usedAt    DateTime @default(now())
}

// ===========================================================================
// CLIENT SELF-SIGNUP, ONBOARDING & PORTAL ACTIVATION
// ===========================================================================

// A signup waiting for its emailed code. No portal login exists until the
// code is entered in the same browser that started the signup, so someone
// can't claim another person's email address.
model PortalSignup {
  id              String    @id @default(cuid())
  emailNormalized String
  name            String
  passwordHash    String
  // Hash of the cookie that ties the signup to the browser that started it.
  browserHash     String    @unique
  codeHash        String
  codeExpiresAt   DateTime
  attempts        Int       @default(0)
  sendCount       Int       @default(1)
  lastSentAt      DateTime
  // False when the address already had a portal login (it got a sign-in reminder instead).
  available       Boolean   @default(true)
  ipHash          String?
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([emailNormalized])
}

enum OnboardingStatus {
  IN_PROGRESS
  // No possible duplicate found: a new client record was created and linked.
  APPROVED_NEW
  // Possible match with an existing record: staff decide.
  NEEDS_REVIEW
  LINKED_EXISTING
  DECLINED
}

model OnboardingApplication {
  id                String           @id @default(cuid())
  portalUserId      String           @unique
  portalUser        PortalUser       @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  status            OnboardingStatus @default(IN_PROGRESS)
  clientType        ClientType       @default(INDIVIDUAL)
  firstName         String?
  lastName          String?
  businessName      String?
  phone             String?
  phoneNormalized   String?
  addressLine1      String?
  city              String?
  state             String?
  postalCode        String?
  servicesRequested String[]
  notes             String?
  // Optional, separate communication choices (applied when the account is linked).
  smsService        Boolean          @default(false)
  smsMarketing      Boolean          @default(false)
  emailMarketing    Boolean          @default(false)
  possibleMatchIds  String[]
  submittedAt       DateTime?
  clientId          String?
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  files OnboardingFile[]

  @@index([status])
}

// Documents uploaded during onboarding, held privately until the account is
// linked to a client record, then moved into that client's documents.
model OnboardingFile {
  id              String                @id @default(cuid())
  applicationId   String
  application     OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  storageKey      String                @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  movedDocumentId String?
  createdAt       DateTime              @default(now())
}

enum ActivationStatus {
  // Exactly one record had this email on file: an invitation went to that address.
  INVITE_SENT
  // Already had a portal login: a sign-in reminder was sent instead.
  ALREADY_ACTIVE
  // No single on-file match: staff verify identity and decide.
  NEEDS_STAFF
  EMAIL_FAILED
  RESOLVED
  DISMISSED
}

model ActivationRequest {
  id               String           @id @default(cuid())
  emailNormalized  String
  name             String?
  phone            String?
  ipHash           String?
  status           ActivationStatus
  matchedClientIds String[]
  inviteId         String?
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([status])
}

// ===========================================================================
// STAFF TEXT ALERTS (Twilio)
// ===========================================================================

// Brief "you have a new client message" texts to the office phone. Never
// include message contents. Off until an Admin turns them on.
model StaffAlertSettings {
  id                     String    @id @default("default")
  smsEnabled             Boolean   @default(false)
  // E.164. The receiving phone, not the Twilio sending number.
  phone                  String    @default("+12056595448")
  // Monday–Friday window in America/Chicago, "HH:MM" 24-hour.
  windowStart            String    @default("08:00")
  windowEnd              String    @default("17:00")
  // Link-only email summary of new client activity (any time of day).
  emailEnabled           Boolean   @default(true)
  email                  String    @default("info@tturnerassociates.com")
  // Staff texting clients from their conversations. Off until Tabitha turns it on.
  clientTextingEnabled   Boolean   @default(false)
  clientTextingChangedAt DateTime?
  clientTextingChangedBy String?
  updatedById            String?
  updatedAt              DateTime  @updatedAt
}

enum StaffAlertStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model StaffAlert {
  id              String           @id @default(cuid())
  // "CLIENT_MESSAGE" (messages and/or uploads) or "TEST" (controlled test from Settings).
  reason          String
  // "SMS" (office phone, weekday window) or "EMAIL" (office inbox, link only).
  channel         String           @default("SMS")
  to              String
  body            String
  // Unread conversations this alert covers (several are combined into one text).
  conversationIds String[]
  // New client uploads covered by this alert (still "Needs Review").
  documentIds     String[]
  status          StaffAlertStatus @default(PENDING)
  notBefore       DateTime
  sentAt          DateTime?
  providerSid     String?          @unique
  // Twilio's own status from delivery callbacks: queued, sent, delivered, undelivered, failed.
  deliveryStatus  String?
  statusDetail    String?
  createdById     String?
  createdAt       DateTime         @default(now())

  @@index([status, notBefore])
}

// Results of the Admin scanner self-test (EICAR test string must be caught,
// a clean file must pass). Files are released from quarantine only by a
// "CLEAN" result from a configured scanner.
model ScannerCheck {
  id          String   @id @default(cuid())
  provider    String
  eicarResult String
  cleanResult String
  ok          Boolean
  detail      String?
  runById     String
  createdAt   DateTime @default(now())
}

// ===========================================================================
// CLIENT RESOURCE CENTER
// ===========================================================================

// One official link (or an honest "not applicable" note) for a state, DC,
// a county/city, or federal ("US"). Shipped verified data lives here and is
// editable by Admins; nothing is presented as complete when it isn't.
model Resource {
  id                 String    @id @default(cuid())
  // Two-letter state code, "DC", or "US" for federal.
  jurisdiction       String
  county             String?
  city               String?
  // e.g. TAX_PORTAL, SALES_USE_TAX, ALCOHOL_LICENSING, FEDERAL_SAM …
  category           String
  title              String
  // One plain sentence: what this link actually handles.
  purpose            String
  agency             String
  url                String?
  phone              String?
  // VERIFIED | NEEDS_VERIFICATION | NOT_APPLICABLE | UNAVAILABLE
  status             String    @default("NEEDS_VERIFICATION")
  // How the link was confirmed: fetched | official-result | in-text | staff
  verificationMethod String?
  notes              String?
  lastVerifiedAt     DateTime?
  // Live link check from the deployed site (HTTP status), never from guesses.
  linkCheckedAt      DateTime?
  linkCheckStatus    Int?
  linkCheckOk        Boolean?
  hidden             Boolean   @default(false)
  sortOrder          Int       @default(0)
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([jurisdiction, category])
}

model ResourceFaq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  tags        String[]
  sortOrder   Int      @default(0)
  hidden      Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================================================================
// IDENTITY DOCUMENTS (permanent, separate from yearly tax folders)
// ===========================================================================

// The client, their spouse, or a dependent on the account.
model IdentityPerson {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // CLIENT | SPOUSE | DEPENDENT
  role       String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  documents IdentityDocument[]

  @@index([clientId])
}

// One uploaded identity document. The file is a Document (category
// IDENTITY), so scanning, protected storage, access logs and retention
// apply. A new upload stays PENDING_VERIFICATION until staff review it.
model IdentityDocument {
  id                 String         @id @default(cuid())
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  personId           String
  person             IdentityPerson @relation(fields: [personId], references: [id], onDelete: Restrict)
  // DRIVERS_LICENSE | BIRTH_CERTIFICATE | SOCIAL_SECURITY_CARD
  type               String
  documentId         String         @unique
  // PENDING_VERIFICATION | VERIFIED | REJECTED | REPLACED | EXPIRED
  status             String         @default("PENDING_VERIFICATION")
  // Driver's licenses only (YYYY-MM-DD). Never set for other types.
  expiresOn          String?
  // Why a replacement was uploaded (renewal, name change, correction, unreadable…).
  replacementReason  String?
  // Social Security cards: only the last four digits, entered by staff, for display.
  last4              String?
  verifiedAt         DateTime?
  verifiedById       String?
  rejectedReason     String?
  replacedAt         DateTime?
  uploadedByPortalId String?
  uploadedByStaffId  String?
  // Expiration reminders already sent: "60", "30", "7", "EXPIRED".
  remindersSent      String[]
  // Staff task to review this upload; closed when it's verified or declined.
  verificationTaskId String?
  createdAt          DateTime       @default(now())

  @@index([clientId, personId, type])
  @@index([status, type])
}

// A client on the monthly/quarterly bookkeeping service.
model BookkeepingProfile {
  clientId              String    @id
  client                Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  active                Boolean   @default(true)
  // MONTHLY | QUARTERLY
  frequency             String    @default("MONTHLY")
  payroll               Boolean   @default(false)
  // The client already pays through recurring billing set up in Square
  // (true for every client on the list when Square linking arrived). While
  // set, Client Connect never asks them to authorize or save a card again.
  squareBillingExpected Boolean   @default(false)
  // WEEKLY | BIWEEKLY | SEMIMONTHLY | MONTHLY
  payrollFrequency      String?
  payrollProvider       String?
  // One known pay date; later pay dates follow payrollFrequency from it.
  payrollPayDate        DateTime? @db.Date
  // Deadlines, set per client by staff (no default): day of the month after
  // the work month when the client's documents are due / reports are due.
  // 31 means the last day of that month. Null = no deadline, never overdue.
  documentsDueDay       Int?
  reportsDueDay         Int?
  // Tabitha's review, day of the month after the work month. No default: shown only when set.
  reviewDueDay          Int?
  // Accounts to collect statements for (e.g. "Regions checking, Amex").
  accounts              String?
  notes                 String?
  updatedById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Business information. Entity type and fiscal year end live on Client.
  legalName           String?
  dba                 String?
  // EIN: encrypted (encryptSecret); only the last four are shown by default.
  // The full number opens for Admins only, and each view is audited.
  einEncrypted        String?
  einLast4            String?
  businessAddress1    String?
  businessAddress2    String?
  businessCity        String?
  businessState       String?
  businessPostalCode  String?
  businessEmail       String?
  contactName         String?
  contactTitle        String?
  contactPhone        String?
  businessStartDate   DateTime?
  // The tax/accounting year being worked; earlier years stay available.
  workingYear         Int?
  // CASH | ACCRUAL | MODIFIED_CASH — shown on every report.
  accountingBasis     String?
  // Payroll account access: NOT_REQUESTED | REQUESTED | ACCOUNTANT_ACCESS | REPORTS_EMAILED | CLIENT_UPLOADS
  payrollAccessStatus String?
  // Payroll reports required each month (keys of PAYROLL_REPORT_TYPES).
  payrollReports      String[]  @default([])
  // HMAC of the EIN, so duplicate businesses can be spotted without decrypting.
  einHash             String?
  contactEmail        String?
  // When an Admin last verified the business information (client onboarding).
  verifiedAt          DateTime?
  verifiedById        String?
  // "Work with Coetha": this client's own Claude Project or conversation link
  // (https://claude.ai/...). Set by Tabitha; opened by authorized staff with
  // their own Claude access. Never a password; nothing syncs automatically.
  coethaUrl           String?
  coethaUpdatedById   String?
  coethaUpdatedAt     DateTime?
}

/// A client's bank or credit-card account for bookkeeping. Never holds
/// passwords, security answers or one-time codes: access is by delegated
/// accountant access, an official connection, or statement uploads.
model BookkeepingAccount {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  institution  String
  // CHECKING | SAVINGS | CREDIT_CARD | LINE_OF_CREDIT | LOAN | MERCHANT | OTHER
  accountType  String
  last4        String?
  nickname     String?
  // The bank's official sign-in page (https only), for delegated access.
  loginUrl     String?
  // NOT_REQUESTED | REQUESTED | DELEGATED_ACCESS | OFFICIAL_CONNECTION | STATEMENTS_ONLY | REVOKED
  accessStatus String     @default("NOT_REQUESTED")
  accessNote   String?
  // How the client gives access: DELEGATED (adds us as accountant user) | OFFICIAL_CONNECTION | STATEMENT_UPLOAD
  accessMethod String?
  active       Boolean    @default(true)
  updatedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]

  @@index([clientId])
}

/// Monthly bookkeeping billing for a client. Card details are never stored:
/// Square holds the payment method; only Square's reference ids live here.
/// Managed by Tabitha, or staff she grants (User.bookkeepingBillingAccess).
model BookkeepingBilling {
  clientId                   String    @id
  client                     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monthlyFeeCents            Int?
  billingStartDate           DateTime?
  // Day of the month the charge is due (1–28).
  billingDay                 Int?
  // NOT_SET_UP | CURRENT | DUE | PAST_DUE | PAUSED
  paymentStatus              String    @default("NOT_SET_UP")
  squareCustomerId           String?
  // Where squareCustomerId came from: MANUAL (typed by hand, never verified),
  // SQUARE_LINK (confirmed through Find and link in Square) or CLIENT_CONNECT
  // (Square returned it when the client saved a card in the portal).
  squareCustomerIdSource     String?
  squareCustomerIdVerifiedAt DateTime?
  squareCardId               String?
  // Monthly tier name set by Tabitha (e.g. "Essentials").
  tierName                   String?
  // Display details exactly as returned by Square for the card on file. Never the number or CVV.
  cardBrand                  String?
  cardLast4                  String?
  cardExpMonth               Int?
  cardExpYear                Int?
  cardSavedAt                DateTime?
  notes                      String?
  updatedById                String?
  updatedAt                  DateTime  @updatedAt
  createdAt                  DateTime  @default(now())
}

/// The client's authorization for recurring charges. A card on file alone authorizes nothing.
model RecurringChargeAuthorization {
  id                       String    @id @default(cuid())
  clientId                 String
  client                   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents              Int
  // MONTHLY
  frequency                String    @default("MONTHLY")
  startDate                DateTime
  // SIGNED_FORM | SIGNED_CONTRACT | PORTAL_CONSENT
  method                   String
  authorizedByName         String
  authorizedAt             DateTime
  evidenceDocumentId       String?
  recordedById             String
  createdAt                DateTime  @default(now())
  revokedAt                DateTime?
  revokedById              String?
  revokeReason             String?
  // Client consent in the portal: who accepted, the exact terms, and the card it applies to.
  authorizedByPortalUserId String?
  termsText                String?
  cardLast4                String?

  @@index([clientId])
}

// One line of a month's checklist: something the client sends
// (CLIENT_DOCUMENT) or something staff do (STAFF_TASK).
model BookkeepingChecklistItem {
  id        String            @id @default(cuid())
  periodId  String
  period    BookkeepingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  key       String
  label     String
  kind      String
  // OPEN | DONE | NOT_NEEDED
  status    String            @default("OPEN")
  doneById  String?
  doneAt    DateTime?
  sortOrder Int               @default(0)

  @@unique([periodId, key])
}

/// Background job heartbeats (e.g. the 10-minute quarantine re-scan), so staff can see whether automatic checks are running.
model SystemHeartbeat {
  key    String   @id
  at     DateTime
  detail Json?
}

/// A client's business & bookkeeping onboarding: eligibility answers and a
/// "Save & Continue Later" draft (the EIN inside the draft is encrypted).
model BusinessOnboarding {
  clientId          String    @id
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // EXISTING | POTENTIAL
  relationship      String?
  wantsBookkeeping  Boolean?
  draft             Json?
  // NOT_STARTED | DRAFT | SUBMITTED (submitted at least once)
  status            String    @default("NOT_STARTED")
  submittedAt       DateTime?
  updatedByPortalId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Business information submitted by a client. Verified details (BookkeepingProfile
/// and accounts) change only when an Admin approves.
model BusinessInfoChange {
  id                   String    @id @default(cuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // INITIAL | UPDATE
  kind                 String
  // Proposed values. The EIN appears only encrypted (einEncrypted) with its last four and hash.
  data                 Json
  // PENDING | APPROVED | REJECTED | SUPERSEDED
  status               String    @default("PENDING")
  possibleDuplicateIds String[]  @default([])
  submittedByPortalId  String?
  submittedAt          DateTime  @default(now())
  reviewedById         String?
  reviewedAt           DateTime?
  reviewNote           String?

  @@index([clientId, status])
}

/// An audit or tax notice a client received (IRS, state or local), with its
/// documents in the client's yearly vault. RECEIVED means only that our office
/// has it — not that it has been reviewed or answered.
model NoticeCase {
  id                String     @id @default(cuid())
  clientId          String
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Null = the client wasn't sure of the tax year.
  taxYear           Int?
  // IRS | STATE | LOCAL | NOT_SURE
  agency            String
  agencyDetail      String?
  receivedOn        DateTime?
  // Null = not known yet.
  responseDueOn     DateTime?
  clientMessage     String?
  // RECEIVED | UNDER_REVIEW | RESPONDED | CLOSED
  status            String     @default("RECEIVED")
  createdByPortalId String?
  createdByStaffId  String?
  updatedById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  documents         Document[]

  @@index([clientId, taxYear])
  @@index([status, responseDueOn])
}

/// Links a person's Personal client record to a business they own or run.
/// Each business stays its own client record (EIN, accounts, billing,
/// documents, staff). Linking never grants portal access by itself.
model ClientRelationship {
  id               String   @id @default(cuid())
  personClientId   String
  person           Client   @relation("RelPerson", fields: [personClientId], references: [id], onDelete: Cascade)
  businessClientId String
  business         Client   @relation("RelBusiness", fields: [businessClientId], references: [id], onDelete: Cascade)
  // OWNER | PARTNER | OFFICER | OTHER
  role             String   @default("OWNER")
  createdById      String
  createdAt        DateTime @default(now())

  @@unique([personClientId, businessClientId])
  @@index([businessClientId])
}

/// An existing recurring billing arrangement in Square (a recurring invoice
/// series), linked read-only. Client Connect never creates, changes or charges
/// it: amounts, schedules and saved cards stay exactly as set up in Square.
/// One arrangement can cover several businesses (one combined bill).
model SquareBillingArrangement {
  id                        String                @id @default(cuid())
  squareCustomerId          String
  squareLocationId          String
  // The series part of Square's invoice numbers ("54499" in "54499-R-0005").
  seriesKey                 String
  customerName              String?
  companyName               String?
  title                     String?
  // From Square's latest invoice in the series.
  amountCents               Int?
  // MONTHLY | QUARTERLY | YEARLY | WEEKLY | UNKNOWN (worked out from the due dates)
  cadence                   String?
  dueDay                    Int?
  nextDueDate               DateTime?
  nextInvoiceStatus         String?
  lastDueDate               DateTime?
  lastInvoiceStatus         String?
  lastPaidDueDate           DateTime?
  // Square charges the card on file automatically (CARD_ON_FILE) vs. the client pays each invoice.
  autopay                   Boolean               @default(false)
  // Card display details exactly as Square returns them. Never the number or CVV.
  squareCardId              String?
  cardBrand                 String?
  cardLast4                 String?
  cardExpMonth              Int?
  cardExpYear               Int?
  invoiceCount              Int                   @default(0)
  // Latest PAID invoice in the series, as Square reports it.
  lastPaidCents             Int?
  // Across all of this customer's invoices at the location (not just the series), from Square.
  outstandingCents          Int?
  outstandingCount          Int?
  overdueCents              Int?
  overdueCount              Int?
  // Invoices Square reports as FAILED (an automatic payment that didn't go through).
  failedCount               Int?
  // Paid invoices due in paidMonth ("YYYY-MM", Central time) — for the Owner's Office totals.
  paidMonth                 String?
  paidMonthCents            Int?
  // syncedAt = last SUCCESSFUL read from Square; syncFailedAt/syncError = the latest failure after it.
  syncedAt                  DateTime?
  syncError                 String?
  syncFailedAt              DateTime?
  // Square's API has no recurring-series status, so "active" is worked out from the series' own
  // invoices (see seriesActivity). An ended link stays as history; it's never deleted.
  active                    Boolean               @default(true)
  // No scheduled/open invoice and no owner decision yet: not shown as current billing until reviewed.
  needsReview               Boolean               @default(false)
  // Every invoice in THIS series as Square reports it, newest first (Payment History): due date,
  // amount, status, and — for paid ones — Square's payment date and receipt link. No card data.
  seriesInvoices            Json?
  endedAt                   DateTime?
  endedReason               String?
  // Clients that were on this bill before it ended and they were linked to a current series.
  formerClientIds           String[]              @default([])
  // Tabitha confirms the authorization already on file in Square; nothing new is asked of the client.
  authorizationVerifiedAt   DateTime?
  authorizationVerifiedById String?
  authorizationNote         String?
  linkedById                String
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  members                   SquareBillingMember[]

  @@unique([squareLocationId, seriesKey])
  @@index([squareCustomerId])
}

/// A business (or person) covered by a Square billing arrangement. A client
/// can be on only one arrangement, so the same client is never billed twice.
model SquareBillingMember {
  id            String                   @id @default(cuid())
  arrangementId String
  arrangement   SquareBillingArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  // A client can be on several Square series (for example separate services); never twice on one.
  clientId      String
  client        Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedById     String
  createdAt     DateTime                 @default(now())

  @@unique([arrangementId, clientId])
  @@index([arrangementId])
  @@index([clientId])
}

/// Annual federal filing setup for a nonprofit client. Each year's return is a
/// FilingRecord (returnType 990-N / 990-EZ / 990 / 990-PF / other), so
/// Submitted and Accepted stay separate and Accepted needs evidence.
model NonprofitProfile {
  clientId      String   @id
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // 990-N | 990-EZ | 990 | 990-PF | OTHER (null = not determined yet)
  formType      String?
  otherForm     String?
  // How staff determined the form (e.g. "Gross receipts normally ≤ $50,000 — 2023–2025 average").
  formBasis     String?
  // Days before the deadline to remind staff (and, if enabled, the client's contacts).
  reminderDays  Int[]    @default([60, 30, 7])
  notifyClient  Boolean  @default(false)
  // Does TTurner handle this organization's annual filings? YES | NO | PENDING_AGREEMENT (null = not recorded).
  // Only YES puts it on Nonprofit Filings' tracker and reminders.
  filingService String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- Services & pricing agreements -------------------------------------------
// One record per billable service a client has with us (a tax return for one
// year, monthly bookkeeping for a period, a formation…). A client can have many
// at once, each with its own status, staff, agreement and billing. Work can't
// start until its pricing agreement is signed (and any payment authorization
// recorded), unless the owner overrides with a logged reason.

enum ServiceType {
  TAX_INDIVIDUAL
  TAX_BUSINESS
  TAX_AMENDED
  TAX_NONPROFIT
  BOOKKEEPING
  PAYROLL
  NONPROFIT_SERVICES
  BUSINESS_FORMATION
  CONSULTING
  PROPERTY_MANAGEMENT
  IRS_CORRESPONDENCE
  OTHER
}

enum ServiceStatus {
  AGREEMENT_PENDING
  AGREEMENT_SENT
  AGREEMENT_VIEWED
  AGREEMENT_SIGNED
  AWAITING_PAYMENT_AUTHORIZATION
  APPROVED_TO_BEGIN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model ClientService {
  id                  String        @id @default(cuid())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  type                ServiceType
  // Tax services name their tax year; others name their period (e.g. "Jan–Dec 2026").
  taxYear             Int?
  periodLabel         String?
  title               String
  description         String?
  status              ServiceStatus @default(AGREEMENT_PENDING)
  assignedToId        String?
  assignedTo          User?         @relation("ServiceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Whether a payment authorization (deposit, card authorization, refund-transfer
  // application…) must be recorded before work may begin.
  requiresPaymentAuth Boolean       @default(false)
  paymentAuthAt       DateTime?
  paymentAuthNote     String?
  paymentAuthById     String?
  // Owner's documented override to begin work without the signed agreement.
  overrideAt          DateTime?
  overrideReason      String?
  overrideById        String?
  completedAt         DateTime?
  closedAt            DateTime?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  agreements PricingAgreement[]

  @@index([clientId, taxYear])
  @@index([status])
}

enum AgreementKind {
  // Service Pricing & Payment Agreement
  SERVICE
  // Tax Preparation Payment Selection & Fee Agreement
  TAX_PAYMENT_SELECTION
}

enum AgreementStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  SUPERSEDED
  VOID
}

model PricingAgreement {
  id               String          @id @default(cuid())
  serviceId        String
  service          ClientService   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clientId         String
  kind             AgreementKind
  version          Int
  status           AgreementStatus @default(DRAFT)
  // Exact terms shown to the client (prices, charges, payment options with their fees, payment terms).
  terms            Json
  // The client's payment-method choice and the totals it produced (frozen at signing).
  selectedMethod   String?
  selection        Json?
  termsHash        String?
  sentAt           DateTime?
  viewedAt         DateTime?
  signedAt         DateTime?
  signerName       String?
  signedByPortalId String?
  signerIp         String?
  signerAgent      String?
  consentText      String?
  pdfDocumentId    String?         @unique
  supersededAt     DateTime?
  voidedAt         DateTime?
  voidReason       String?
  createdById      String
  createdAt        DateTime        @default(now())

  @@unique([serviceId, version])
  @@index([clientId, status])
}

// Fees by payment method. A fee applies only when the owner has turned it on and
// recorded how it was verified as permitted; otherwise the method has no fee.
model PaymentFeeSetting {
  method       String    @id
  enabled      Boolean   @default(false)
  // Basis points for a percentage fee (350 = 3.5%), or cents for a flat fee.
  percentBps   Int       @default(0)
  flatCents    Int       @default(0)
  verifiedNote String?
  verifiedAt   DateTime?
  verifiedById String?
  // Refund transfer: the third-party provider offering it (must be set to offer the option).
  providerName String?
  updatedAt    DateTime  @updatedAt
}

/// A completed return uploaded through the bulk screen, waiting for staff to
/// confirm the client, business, tax year, return type and jurisdiction.
/// Until confirmed it belongs to no client and stays staff-only.
model ReturnIntake {
  id                String    @id @default(cuid())
  fileId            String    @unique
  originalName      String
  sha256            String
  // Suggested match (never applied without confirmation) and why.
  suggestedClientId String?
  matchReason       String?
  suggestedYear     Int?
  suggestedType     String?
  // PENDING | FILED | DISCARDED
  status            String    @default("PENDING")
  documentId        String?
  uploadedById      String
  filedById         String?
  filedAt           DateTime?
  discardedReason   String?
  createdAt         DateTime  @default(now())

  @@index([status])
}

// --- Nonprofit Formation & Compliance Center ----------------------------------
// One portfolio per nonprofit organization record (a Client of type Nonprofit,
// linked to its owner's record as in PR #31). It holds the organization's
// formation facts, federal and state status, checklist and released documents.

model NonprofitPortfolio {
  clientId               String    @id
  client                 Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  legalName              String?
  formationState         String?
  formationDate          DateTime? @db.Date
  ein                    String?
  sosEntityNumber        String?
  sosFilingDate          DateTime? @db.Date
  registeredAgent        String?
  registeredAgentAddress String?
  // Key from NonprofitClassification (e.g. "501C3"); null = not decided.
  classification         String?
  // Attorney General charitable solicitation: REVIEW_NEEDED | REQUIRED | REGISTERED | EXEMPT | NOT_APPLICABLE
  agStatus               String?
  agNote                 String?
  agRenewalDate          DateTime? @db.Date
  // SAM.gov: NOT_STARTED | IN_PROGRESS | ACTIVE | EXPIRED | NOT_APPLICABLE
  samStatus              String?
  uei                    String?
  samExpiresOn           DateTime? @db.Date
  mission                String?
  programs               String?
  // Formation package purchased (NonprofitPackage key), the service it's billed under, and how government fees are handled.
  packageKey             String?
  serviceId              String?
  govFeesMode            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  officers  NonprofitOfficer[]
  irsEvents NonprofitIrsEvent[]
  items     NonprofitChecklistItem[]
}

model NonprofitOfficer {
  id          String             @id @default(cuid())
  portfolioId String
  portfolio   NonprofitPortfolio @relation(fields: [portfolioId], references: [clientId], onDelete: Cascade)
  name        String
  role        String
  termStart   DateTime?          @db.Date
  termEnd     DateTime?          @db.Date
  removedAt   DateTime?
  createdAt   DateTime           @default(now())
}

// IRS exemption application history; each step is its own dated entry.
model NonprofitIrsEvent {
  id          String             @id @default(cuid())
  portfolioId String
  portfolio   NonprofitPortfolio @relation(fields: [portfolioId], references: [clientId], onDelete: Cascade)
  // SUBMITTED | PENDING_REVIEW | INFO_REQUESTED | INFO_RESPONDED | APPROVED | DENIED | DETERMINATION_LETTER_RECEIVED | WITHDRAWN
  kind        String
  at          DateTime
  note        String?
  reference   String?
  documentId  String?
  byId        String
  createdAt   DateTime           @default(now())

  @@index([portfolioId, at])
}

// Owner-editable list of federal exemption categories and how each applies.
model NonprofitClassification {
  key          String    @id
  label        String
  // Plain-language process (form, whether an application is required) with its IRS source.
  process      String
  form         String?
  sourceUrl    String?
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  // Set when the owner or staff confirm the process against the official source.
  verifiedAt   DateTime?
  verifiedNote String?
  updatedAt    DateTime  @updatedAt
}

// Updateable state requirement templates. Items: [{ key, label, category, required, note, sourceUrl }].
model NonprofitStateTemplate {
  state        String    @id
  items        Json
  verifiedAt   DateTime?
  verifiedNote String?
  updatedById  String?
  updatedAt    DateTime  @updatedAt
}

model NonprofitChecklistItem {
  id              String             @id @default(cuid())
  portfolioId     String
  portfolio       NonprofitPortfolio @relation(fields: [portfolioId], references: [clientId], onDelete: Cascade)
  // Template key when it came from a state template; null for items staff added.
  templateKey     String?
  label           String
  // STATE | FEDERAL | GOVERNANCE | GRANT | OTHER
  category        String             @default("OTHER")
  // NOT_STARTED | INFORMATION_NEEDED | PREPARING | READY_FOR_REVIEW | SUBMITTED | AWAITING_GOVERNMENT | APPROVED_FILED | COMPLETED | DELIVERED | NOT_APPLICABLE
  // Portfolio section: FORMATION | IRS | STATE | SAM | GRANT | OTHER
  section         String             @default("OTHER")
  // Included in the client's package (our deliverable) vs. a government requirement — tracked separately; an item can be both.
  deliverable     Boolean            @default(false)
  requirement     Boolean            @default(false)
  status          String             @default("NOT_STARTED")
  responsibleId   String?
  completedAt     DateTime?
  filingReference String?
  staffNote       String?
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  files NonprofitItemFile[]

  @@unique([portfolioId, templateKey])
}

// A file on a checklist item. Only non-draft files can be released to the client.
model NonprofitItemFile {
  id           String                 @id @default(cuid())
  itemId       String
  item         NonprofitChecklistItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  documentId   String                 @unique
  // GOVERNMENT_ISSUED | FINAL_PREPARED | CLIENT_PREPARED | INTERNAL_DRAFT
  origin       String
  uploadedById String
  createdAt    DateTime               @default(now())
  releasedAt   DateTime?
  releasedById String?

  @@index([itemId])
}

// --- In-house payment plans & payment-method controls ---------------------------------
// Plans are computed on the server (30% deposit, equal monthly installments, final
// installment absorbs rounding). Nothing is charged until the client accepted the
// terms, the owner approved, and a card-on-file authorization is recorded.

model InstallmentPlan {
  id                   String    @id @default(cuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceId            String?
  serviceId            String?
  title                String
  // REQUESTED | PENDING_APPROVAL | APPROVED | DECLINED | DEPOSIT_PENDING | ACTIVE | PAST_DUE | PAID_IN_FULL | CANCELLED
  status               String    @default("REQUESTED")
  serviceCents         Int
  // CARD_CREDIT | CARD_DEBIT (debit never carries a fee)
  card                 String
  months               Int
  feeCents             Int
  totalCents           Int
  depositCents         Int
  // [{ seq, dueDate, amountCents }]
  schedule             Json
  terms                Json
  termsHash            String
  requestedById        String?
  requestedByPortalId  String?
  acceptedAt           DateTime?
  acceptedByPortalId   String?
  acceptedName         String?
  acceptedIp           String?
  approvedAt           DateTime?
  approvedById         String?
  declinedAt           DateTime?
  declinedById         String?
  declineReason        String?
  // Card-on-file authorization (Square, added with the Square integration). Never card numbers.
  cardAuthorizedAt     DateTime?
  cardAuthorizationRef String?
  verifiedCardType     String?
  paidCents            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clientId, status])
  @@index([status])
}

// Payment instructions shown to the client for each method (owner-edited; not secrets).
model PaymentInstruction {
  method      String   @id
  label       String
  details     String
  active      Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Changing an invoice's or plan's payment method needs the owner's approval.
model PaymentMethodChange {
  id                  String    @id @default(cuid())
  clientId            String
  invoiceId           String?
  planId              String?
  fromMethod          String?
  toMethod            String
  reason              String?
  requestedById       String?
  requestedByPortalId String?
  // PENDING | APPROVED | DECLINED
  status              String    @default("PENDING")
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  createdAt           DateTime  @default(now())

  @@index([status])
}

// Late-fee policy: configurable, disabled until the owner records a legal review and turns it on.
model LateFeeSettings {
  id           String    @id @default("default")
  enabled      Boolean   @default(false)
  graceDays    Int       @default(5)
  periodDays   Int       @default(5)
  rateBps      Int       @default(1000)
  capBps       Int?
  reviewedNote String?
  reviewedAt   DateTime?
  reviewedById String?
  updatedAt    DateTime  @updatedAt
}

// Waived late fees (owner only), kept for reconciliation.
model FeeWaiver {
  id          String   @id @default(cuid())
  clientId    String
  planId      String?
  invoiceId   String?
  amountCents Int
  reason      String
  waivedById  String
  createdAt   DateTime @default(now())
}

// Owner-editable formation packages. Deliverables: [{ key, label, section }] — the documents we provide.
model NonprofitPackage {
  key             String   @id
  name            String
  priceCents      Int
  // e.g. "Starting at" for packages priced by state.
  priceNote       String?
  // Price by state, e.g. { "GA": 375000 }; the base price applies otherwise.
  statePrices     Json?
  // Government filing fees: INCLUDED in the price, or ADDED to it.
  govFeesMode     String   @default("ADDED")
  deliverables    Json
  grantDisclaimer Boolean  @default(false)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

// Result of a live, read-only Square connection check. "Configured" (variables present) is not the same as working.
model SquareHealthCheck {
  id          String   @id @default(cuid())
  checkedAt   DateTime @default(now())
  // true only when Square accepted the token and every required read permission worked
  ok          Boolean
  environment String
  summary     String
  // Each step: { key, label, ok, status, code, detail } — never the token
  steps       Json
  checkedById String?

  @@index([checkedAt])
}

// Keeps a scheduled job from running twice at once (e.g. the hourly Square sync).
model JobLock {
  name        String   @id
  lockedUntil DateTime
  runId       String?
}

// The owner's decision on a recurring series whose status Square's invoices can't settle
// (no scheduled or open invoice). A new scheduled/open invoice in Square always wins.
model SquareSeriesReview {
  id               String   @id @default(cuid())
  squareLocationId String
  seriesKey        String
  squareCustomerId String
  // ACTIVE | ENDED
  decision         String
  reason           String
  decidedById      String
  decidedAt        DateTime @default(now())

  @@unique([squareLocationId, seriesKey])
}

// A payment recorded by the office for a client billed outside Square (cash, check, Zelle, ACH…).
// Never shown as Square-verified. Corrections void a payment with a reason; nothing is deleted.
model ManualBillingPayment {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents  Int
  paidOn       DateTime
  // The billing month this payment covers ("YYYY-MM").
  periodMonth  String
  // CASH | CHECK | ZELLE | ACH | CARD | OTHER
  method       String
  reference    String?
  note         String?
  recordedById String
  createdAt    DateTime  @default(now())
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?

  @@index([clientId, paidOn])
}

// ===========================================================================
// CLIENT BOOKKEEPING LEDGER — double-entry books, one set per client.
// Every query is scoped to one client; nothing here is shared between clients
// or with the Owner's Office. Amounts are integer cents.
// ===========================================================================

model LedgerBook {
  clientId             String               @id
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // CASH | ACCRUAL — the basis this client's statements use by default.
  basis                String               @default("CASH")
  fiscalYearStartMonth Int                  @default(1)
  // Opening balances are posted once, as of this date. Nothing may be dated before it.
  openingDate          DateTime?            @db.Date
  // Closed (approved) through this date: entries dated on or before it can't be posted or reversed.
  lockedThrough        DateTime?            @db.Date
  lockedById           String?
  lockedAt             DateTime?
  createdById          String
  createdAt            DateTime             @default(now())
  accounts             LedgerAccount[]
  entries              JournalEntry[]
  bankTransactions     BankTransaction[]
  reconciliations      BankReconciliation[]
  rules                CategorizationRule[]
  customers            InvoiceCustomer[]
  invoices             ClientInvoice[]
  recurringInvoices    RecurringInvoice[]
}

model LedgerAccount {
  id               String               @id @default(cuid())
  clientId         String
  book             LedgerBook           @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  code             String
  name             String
  // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  type             String
  // BANK | CREDIT_CARD | AR | AP | OWNER_DRAW | OWNER_CONTRIBUTION | RETAINED_EARNINGS | OPENING_BALANCE | COGS | OTHER_INCOME | OTHER_EXPENSE | SUSPENSE
  subtype          String?
  description      String?
  institution      String?
  last4            String?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  lines            JournalLine[]
  bankTransactions BankTransaction[]
  reconciliations  BankReconciliation[]

  @@unique([clientId, code])
  @@index([clientId, type])
}

model JournalEntry {
  id               String            @id @default(cuid())
  clientId         String
  book             LedgerBook        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  date             DateTime          @db.Date
  memo             String
  // MANUAL | OPENING | BANK | ADJUSTMENT | REVERSAL (later: INVOICE | PAYMENT | PAYOUT)
  source           String
  // The same source (opening balances, a bank transaction, later an invoice or payment) is never posted twice.
  sourceKey        String?
  // BOTH | CASH_ONLY | ACCRUAL_ONLY — which basis of statements includes this entry.
  basis            String            @default("BOTH")
  // Corrections never edit an entry: a reversal is posted instead, and both stay in the history.
  reversalOfId     String?           @unique
  reversalOf       JournalEntry?     @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy       JournalEntry?     @relation("Reversal")
  reason           String?
  createdById      String?
  createdAt        DateTime          @default(now())
  lines            JournalLine[]
  bankTransactions BankTransaction[]

  @@unique([clientId, sourceKey])
  @@index([clientId, date])
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  debitCents  Int           @default(0)
  creditCents Int           @default(0)
  description String?

  @@index([entryId])
  @@index([accountId])
}

model BankImport {
  id           String            @id @default(cuid())
  clientId     String
  accountId    String
  fileName     String
  fileSha256   String
  rows         Int
  added        Int
  duplicates   Int
  firstDate    DateTime?         @db.Date
  lastDate     DateTime?         @db.Date
  createdById  String
  createdAt    DateTime          @default(now())
  transactions BankTransaction[]

  @@index([clientId, accountId])
}

model BankTransaction {
  id                   String        @id @default(cuid())
  clientId             String
  book                 LedgerBook    @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  accountId            String
  account              LedgerAccount @relation(fields: [accountId], references: [id])
  importId             String?
  import               BankImport?   @relation(fields: [importId], references: [id])
  date                 DateTime      @db.Date
  // Money in is positive, money out negative, as the statement shows it.
  amountCents          Int
  description          String
  // Same date + amount + description + occurrence: a row seen in an overlapping statement is skipped.
  fingerprint          String
  // CSV (statement import) | PLAID (daily retrieval)
  source               String        @default("CSV")
  // The bank's own transaction ID (Plaid). A row is never added twice for one ID.
  providerId           String?
  // Set when a statement row confirmed a row that daily retrieval already brought in.
  statementFingerprint String?
  // POSSIBLE_DUPLICATE | CHANGED_AFTER_POSTING | REMOVED_AFTER_POSTING — for staff, never resolved automatically
  flag                 String?
  flagNote             String?
  // UNREVIEWED | POSTED | EXCLUDED
  status               String        @default("UNREVIEWED")
  journalEntryId       String?
  journalEntry         JournalEntry? @relation(fields: [journalEntryId], references: [id])
  postings             Int           @default(0)
  excludedReason       String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())

  @@unique([accountId, fingerprint])
  @@unique([accountId, providerId])
  @@unique([accountId, statementFingerprint])
  @@index([clientId, status])
  @@index([accountId, date])
}

model BankReconciliation {
  id                    String        @id @default(cuid())
  clientId              String
  book                  LedgerBook    @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  accountId             String
  account               LedgerAccount @relation(fields: [accountId], references: [id])
  statementDate         DateTime      @db.Date
  statementBalanceCents Int
  ledgerBalanceCents    Int
  completedById         String
  createdAt             DateTime      @default(now())

  @@unique([accountId, statementDate])
}

/// A staff-approved rule ("descriptions containing X → account Y"). Rules and past postings only
/// SUGGEST a category; a person still posts each transaction.
model CategorizationRule {
  id          String     @id @default(cuid())
  clientId    String
  book        LedgerBook @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  // Upper-case words to look for in the bank description.
  matchText   String
  // IN (money in) | OUT (money out) | ANY
  direction   String     @default("ANY")
  accountId   String
  active      Boolean    @default(true)
  createdById String
  createdAt   DateTime   @default(now())

  @@unique([clientId, matchText, direction])
}

// ===========================================================================
// CLIENT INVOICING (foundation) — a bookkeeping client's own invoices to THEIR
// customers. Separate from the office's Square billing. Payments are recorded
// through a clearing account so a later bank deposit is never counted twice.
// Stripe Connect runs in TEST mode only until Tabitha approves live payments.
// ===========================================================================

model StripeConnectAccount {
  clientId        String   @id
  // The client's OWN connected account (acct_…). Payments go to it, never the office.
  stripeAccountId String   @unique
  // Always false until live payments are approved.
  livemode        Boolean  @default(false)
  chargesEnabled  Boolean  @default(false)
  payoutsEnabled  Boolean  @default(false)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InvoiceCustomer {
  id        String             @id @default(cuid())
  clientId  String
  book      LedgerBook         @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  invoices  ClientInvoice[]
  recurring RecurringInvoice[]

  @@index([clientId])
}

model ClientInvoice {
  id              String                 @id @default(cuid())
  clientId        String
  book            LedgerBook             @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  customerId      String
  customer        InvoiceCustomer        @relation(fields: [customerId], references: [id])
  // INV-1001, INV-1002 … per client
  number          String
  issueDate       DateTime               @db.Date
  dueDate         DateTime               @db.Date
  // DRAFT | OPEN | PARTIALLY_PAID | PAID | VOID
  status          String                 @default("DRAFT")
  totalCents      Int
  paidCents       Int                    @default(0)
  memo            String?
  // Days after the due date to remind the customer (sending is a later phase).
  reminderDays    Int[]                  @default([3, 7, 14])
  recurringId     String?
  recurring       RecurringInvoice?      @relation(fields: [recurringId], references: [id])
  stripeInvoiceId String?                @unique
  issuedAt        DateTime?
  voidedAt        DateTime?
  voidReason      String?
  createdById     String
  createdAt       DateTime               @default(now())
  lines           ClientInvoiceLine[]
  payments        ClientInvoicePayment[]

  @@unique([clientId, number])
  @@index([clientId, status])
}

model ClientInvoiceLine {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int           @default(1)
  unitCents       Int
  amountCents     Int
  incomeAccountId String
}

model ClientInvoicePayment {
  id                    String        @id @default(cuid())
  clientId              String
  invoiceId             String
  invoice               ClientInvoice @relation(fields: [invoiceId], references: [id])
  amountCents           Int
  // Processing fee kept by the processor (Stripe), recorded as an expense.
  feeCents              Int           @default(0)
  receivedOn            DateTime      @db.Date
  // STRIPE_TEST | CHECK | CASH | ACH | ZELLE | OTHER
  method                String
  reference             String?
  // One Stripe payment is recorded once.
  stripePaymentIntentId String?       @unique
  // R-0001 … per client
  receiptNumber         String
  createdById           String
  createdAt             DateTime      @default(now())

  @@unique([clientId, receiptNumber])
  @@index([invoiceId])
}

/// Creates DRAFT invoices on a schedule. Drafts are reviewed before they're issued; nothing is sent automatically.
model RecurringInvoice {
  id          String          @id @default(cuid())
  clientId    String
  book        LedgerBook      @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  customerId  String
  customer    InvoiceCustomer @relation(fields: [customerId], references: [id])
  // MONTHLY | QUARTERLY | YEARLY
  cadence     String
  // Periods are counted from the start date, so month-end schedules don't drift (Jan 31 → Feb 28 → Mar 31).
  startDate   DateTime        @db.Date
  periods     Int             @default(0)
  nextDate    DateTime        @db.Date
  dueDays     Int             @default(15)
  // [{ description, quantity, unitCents, incomeAccountId }]
  lines       Json
  memo        String?
  active      Boolean         @default(true)
  createdById String
  createdAt   DateTime        @default(now())
  invoices    ClientInvoice[]
}

// ===========================================================================
// DAILY BANK RETRIEVAL (Plaid, read-only). Sandbox only in this phase; real
// banks are connected only after Tabitha approves the authorization process.
// Access tokens are encrypted at rest and never shown.
// ===========================================================================

model BankConnection {
  id                  String                  @id @default(cuid())
  clientId            String
  provider            String                  @default("PLAID")
  // SANDBOX only until live banking is approved.
  environment         String                  @default("SANDBOX")
  itemId              String                  @unique
  accessTokenEnc      String
  institutionName     String?
  // ACTIVE | NEEDS_REAUTH | ERROR | DISCONNECTED
  status              String                  @default("ACTIVE")
  // Plaid transactions/sync cursor: where the last successful retrieval stopped.
  cursor              String?
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  // Who authorized read-only access, and how (recorded at connection time).
  authorizedByName    String
  authorizationMethod String
  consentVersion      String
  connectedById       String
  createdAt           DateTime                @default(now())
  disconnectedAt      DateTime?
  disconnectedById    String?
  accounts            BankConnectionAccount[]
  runs                BankSyncRun[]

  @@index([clientId])
}

model BankConnectionAccount {
  id                String         @id @default(cuid())
  connectionId      String
  connection        BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerAccountId String
  name              String
  mask              String?
  // depository / credit / loan … as the bank reports it
  type              String
  subtype           String?
  // The client's ledger bank or card account it feeds. Unmapped accounts are not retrieved.
  ledgerAccountId   String?        @unique
  createdAt         DateTime       @default(now())

  @@unique([connectionId, providerAccountId])
}

model BankSyncRun {
  id           String         @id @default(cuid())
  connectionId String
  connection   BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  // DAILY | MANUAL
  trigger      String
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  // RUNNING | OK | FAILED
  status       String         @default("RUNNING")
  added        Int            @default(0)
  matched      Int            @default(0)
  modified     Int            @default(0)
  removed      Int            @default(0)
  skipped      Int            @default(0)
  flagged      Int            @default(0)
  errorCode    String?

  @@index([connectionId, startedAt])
}

// One tax-preparation case per client per tax year. A joint return (Married
// Filing Jointly) is ONE case on ONE client record: the client record is the
// primary taxpayer, the spouse is recorded here. Never two records or two
// returns for the spouses.
model TaxPrepCase {
  id                      String    @id @default(cuid())
  clientId                String
  client                  Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxYear                 Int
  // 1040_SINGLE | 1040_MFJ | 1040_MFS | 1040_HOH | 1040_QSS | 1065 | 1120S |
  // 1120 | 990 | 1041 | OTHER. Null = still needs staff to select it.
  returnType              String?
  // Form name when returnType = OTHER (e.g. "706", "1040-NR").
  otherReturnForm         String?
  // TAXACT_IMPORT (prefilled from the TaxAct file) | STAFF
  returnTypeSource        String?
  returnTypeConfirmedAt   DateTime?
  returnTypeConfirmedById String?
  // Primary taxpayer as named on the return (the client record holds contact details).
  primaryFirstName        String?
  primaryMiddleName       String?
  primaryLastName         String?
  // Spouse on a joint (or MFS) return.
  spouseFirstName         String?
  spouseMiddleName        String?
  spouseLastName          String?
  spouseEmail             String?
  spousePhone             String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([clientId, taxYear])
  @@index([taxYear, returnType])
}

// Jotform questionnaire submissions waiting for staff: unmatched ones (no or
// invalid signed reference) and, while automatic filing is off, every one.
// Only identifiers are kept here; answers are read from Jotform when filed.
model JotformInbox {
  id                String    @id @default(cuid())
  submissionId      String    @unique
  formId            String
  questionnaireId   String?
  taxYear           Int?
  // From a valid signed reference (client + year); still confirmed by staff.
  suggestedClientId String?
  // HELD (auto-filing off) | NO_REFERENCE | BAD_REFERENCE | FORM_YEAR_MISMATCH | CLIENT_NOT_FOUND
  reason            String
  emails            String[]  @default([])
  // PENDING | FILED | DISMISSED
  status            String    @default("PENDING")
  receivedAt        DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedById      String?
  filedClientId     String?

  @@index([status, receivedAt])
}

// Owner switches for integrations (one row, id "default").
model IntegrationSettings {
  id                     String   @id @default("default")
  // Off until Tabitha approves: questionnaire webhooks go to the staff inbox
  // instead of being filed to client records automatically.
  jotformAutoFileEnabled Boolean  @default(false)
  updatedById            String?
  updatedAt              DateTime @updatedAt
}

// ===========================================================================
// Tax Return Summary & Approval (before filing)
// ===========================================================================
//
// Clients never review the full return before filing. The office enters the
// key figures from the return prepared in TaxAct, sends this summary to the
// portal, and the client approves it for filing (electronic signature) or
// requests changes. A joint return needs the spouse's own signature. Figures
// are locked once sent: any change is a new version, which invalidates every
// earlier approval. Approval never files anything — only Tabitha submits
// through TaxAct — and it does not replace Form 8879 or a state e-file
// authorization. Amounts are whole cents; bank details are last four only.

enum TaxSummaryStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  CLIENT_APPROVED
  SUPERSEDED
  WITHDRAWN
}

model TaxReturnSummary {
  id                  String                @id @default(cuid())
  clientId            String
  client              Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxYear             Int
  // ORIGINAL | AMENDED
  filingType          String                @default("ORIGINAL")
  version             Int                   @default(1)
  replacesId          String?
  status              TaxSummaryStatus      @default(DRAFT)
  // SINGLE | MFJ | MFS | HOH | QSS
  filingStatus        String
  taxpayerName        String
  spouseName          String?
  // [{ name, relationship }] — names only, never SSNs.
  dependents          Json                  @default("[]")
  wagesCents          Int                   @default(0)
  otherIncomeCents    Int                   @default(0)
  totalIncomeCents    Int                   @default(0)
  agiCents            Int                   @default(0)
  // STANDARD | ITEMIZED
  deductionType       String                @default("STANDARD")
  deductionCents      Int                   @default(0)
  taxableIncomeCents  Int                   @default(0)
  // Positive = refund, negative = amount owed, 0 = even.
  federalResultCents  Int                   @default(0)
  // [{ state, resultCents }] — each state separately.
  stateResults        Json                  @default("[]")
  depositBankName     String?
  // CHECKING | SAVINGS
  depositAccountType  String?
  depositRoutingLast4 String?
  depositAccountLast4 String?
  // Shown to the client with the figures.
  officeNote          String?
  // SHA-256 of the figures above; signatures carry the hash they approved.
  figuresHash         String
  preparedById        String
  sentAt              DateTime?
  sentById            String?
  changesRequestedAt  DateTime?
  changesRequestNote  String?
  changesRequestedBy  String?
  approvedAt          DateTime?
  invalidatedAt       DateTime?
  invalidatedReason   String?
  // Last four only — full SSNs are never stored here.
  taxpayerSsnLast4    String?
  spouseSsnLast4      String?
  // The prepared return PDF from TaxAct (staff-only document) — the
  // reference every item is reconciled against before sending.
  returnDocumentId    String?
  extractedAt         DateTime?
  // Figures read from the prepared return (proposals until verified).
  returnTotals        Json?
  // What the client flagged: [{ itemId?, label, note }].
  changesRequestItems Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  signatures          TaxSummarySignature[]
  items               TaxSummaryItem[]
  checks              TaxSummaryCheck[]

  @@index([clientId, taxYear])
  @@index([status])
}

model TaxSummarySignature {
  id            String           @id @default(cuid())
  summaryId     String
  summary       TaxReturnSummary @relation(fields: [summaryId], references: [id], onDelete: Restrict)
  // TAXPAYER | SPOUSE
  role          String
  // Typed full name (the electronic signature).
  signerName    String
  portalUserId  String?
  signedAt      DateTime         @default(now())
  ipAddress     String?
  userAgent     String?
  // The exact statement the signer agreed to.
  consentText   String
  figuresHash   String
  invalidatedAt DateTime?

  @@unique([summaryId, role])
}

// One entry from the prepared return — each W-2 employer, each 1099 payer,
// each Schedule C business, each deduction or credit — shown to the client
// individually. Extracted entries are proposals until staff verify them
// against the prepared return.
model TaxSummaryItem {
  id               String           @id @default(cuid())
  summaryId        String
  summary          TaxReturnSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  // INCOME | ADJUSTMENT | DEDUCTION | CREDIT | PAYMENT | OTHER
  section          String
  // W-2, 1099-R, 1099-NEC, SCH-C, 1098, 1098-T, CREDIT, …
  formType         String
  payerName        String
  // TAXPAYER | SPOUSE | JOINT
  recipient        String           @default("TAXPAYER")
  // [{ key, label, cents }] read from the uploaded source document (W-2, 1099…).
  documentAmounts  Json?
  // [{ key, label, cents }] as entered on the prepared return / TaxAct detail.
  // Only these — once staff verify them — reach the client's summary.
  returnAmounts    Json?
  // RETURN | DOCUMENT | BOTH | STAFF
  source           String
  sourceDocumentId String?
  sourcePage       Int?
  // Where the return figures were read (page/line) and the text (SSNs and account numbers masked).
  evidence         String?
  // VERIFIED | NEEDS_REVIEW | MISSING (on a document, not found on the return) | MISMATCH | EXCLUDED
  status           String           @default("NEEDS_REVIEW")
  // Whether the item is reported on the prepared return.
  onReturn         Boolean          @default(true)
  note             String?
  verifiedById     String?
  verifiedAt       DateTime?
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([summaryId])
}

// A reconciliation problem staff must resolve before sending: conflicting
// amounts, an uploaded document not on the return, a return line without
// item detail, figures not yet verified.
model TaxSummaryCheck {
  id             String           @id @default(cuid())
  summaryId      String
  summary        TaxReturnSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  code           String
  // BLOCKING | WARNING
  severity       String           @default("BLOCKING")
  message        String
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime         @default(now())

  @@unique([summaryId, code])
}

/// Pay From My Refund (Republic Bank Refund Transfer) for one client and tax year. Client Connect
/// only tracks it: Republic Bank's own application and agreement are the authorization, and a
/// fee is never treated as paid until the deposit is actually received and recorded here.
/// REQUESTED (client asked; office review) → AWAITING_DEPOSIT (office set the fee owed) →
/// RECEIVED | SHORT (part paid; rest owed another way) | NOT_RECEIVED (pay another way) | CANCELLED.
model RefundTransferPayment {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taxYear        Int
  status         String                @default("REQUESTED")
  // Preparation fee to be paid from the refund (set by the office once the return is done).
  amountCents    Int?
  receivedCents  Int?
  receivedOn     DateTime?             @db.Date
  // The client's answer to the Treasury Offset Program check: CHECKED | NOT_CHECKED | NEEDS_HELP.
  debtCheck      String?
  // Client said they or their spouse may owe debts that could offset the refund (YES | NOT_SURE | NO).
  offsetRisk     String?
  acknowledgedAt DateTime?
  note           String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  events         RefundTransferEvent[]

  @@unique([clientId, taxYear])
  @@index([status])
}

/// Append-only history for a Pay From My Refund record.
model RefundTransferEvent {
  id                String                @id @default(cuid())
  paymentId         String
  payment           RefundTransferPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action            String
  fromStatus        String?
  toStatus          String?
  amountCents       Int?
  actorUserId       String?
  actorPortalUserId String?
  note              String?
  createdAt         DateTime              @default(now())

  @@index([paymentId, createdAt])
}

/// A request to convert a client (one business) to Managed Business access.
/// Raised by the owner or staff she authorized; only the owner decides.
model BusinessAccessRequest {
  id            String                      @id @default(cuid())
  clientId      String
  client        Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                        @relation("BusinessAccessRequester", fields: [requestedById], references: [id])
  // Services the firm actively provides (bookkeeping, payroll, accounting, reporting…).
  services      String[]
  reason        String
  status        BusinessAccessRequestStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?                       @relation("BusinessAccessDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime                    @default(now())

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

/// Append-only history of every business-access change (never edited or deleted).
model BusinessAccessEvent {
  id           String          @id @default(cuid())
  clientId     String?
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // REQUESTED | APPROVED | DECLINED | CANCELLED | REMOVED | REQUESTER_GRANTED | REQUESTER_REVOKED | LOGIN_VIEW_ON | LOGIN_VIEW_OFF
  action       String
  fromStatus   BusinessAccess?
  toStatus     BusinessAccess?
  requestId    String?
  targetUserId String?
  note         String?
  createdAt    DateTime        @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
}

/// A business license or permit the office tracks for a bookkeeping client (renewal reminders on the overview).
model BusinessLicense {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  jurisdiction  String?
  licenseNumber String?
  renewalDate   DateTime? @db.Date
  note          String?
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId, renewalDate])
}

/// Year-end W-2 / 1099 work for one client and tax year.
model YearEndFiling {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxYear     Int
  // NOT_STARTED | CONTRACTOR_REVIEW | FORMS_PREPARED | FILED
  stage       String   @default("NOT_STARTED")
  note        String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, taxYear])
}

// ===========================================================================
// CAMPAIGN DELIVERY
// ===========================================================================
//
// One row per address per channel per campaign, created at send time after
// permissions are re-checked. The unique key means a retry or an overlapping
// run can never send the same campaign to the same address twice.

enum CampaignMessageStatus {
  SKIPPED
  SENDING
  PROVIDER_ACCEPTED
  FAILED
}

model CampaignMessage {
  id          String                @id @default(cuid())
  campaignId  String
  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel     Channel
  address     String
  clientId    String
  contactId   String?
  status      CampaignMessageStatus
  skipReason  String?
  providerId  String?
  errorDetail String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([campaignId, channel, address])
  @@index([campaignId, status])
}

// ===========================================================================
// COMMUNICATION PREFERENCES
// ===========================================================================
//
// The client's master communication choices. Whether a channel may be used is
// still decided by the consent ledger (ConsentRecord / SmsConsentEvent) and
// the Suppression table, which every change writes through to; this row
// holds the one choice that has no ledger of its own (general business
// updates). One row per person: the client's primary details (personKey
// "primary") or one additional contact (personKey = contact id).

model CommunicationPreference {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  personKey      String
  generalUpdates Boolean  @default(true)
  updatedSource  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clientId, personKey])
}

enum CommPrefCategory {
  PROMO_EMAIL
  PROMO_SMS
  GENERAL_UPDATES
}

// History: who changed what, when, and how (portal, email link, one-click
// unsubscribe, STOP/START reply, staff on the client's request).
model CommunicationPreferenceChange {
  id           String           @id @default(cuid())
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId    String?
  category     CommPrefCategory
  subscribed   Boolean
  // PORTAL | EMAIL_LINK | ONE_CLICK | STOP_REPLY | START_REPLY | STAFF
  source       String
  address      String?
  portalUserId String?
  actorId      String?
  note         String?
  createdAt    DateTime         @default(now())

  @@index([clientId, createdAt])
// Square webhook deliveries, one row per Square event_id, so a replayed event is never applied twice.
model SquareWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  type        String
  objectId    String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      String?

  @@index([receivedAt])
}

// Square payments seen by the webhook or the reconcile job. MATCHED = recorded on one of our
// invoices; UNMATCHED = needs staff review; RECURRING = a recurring-billing customer already
// tracked under Square billing; DISMISSED = reviewed, not a Client Connect invoice.
model SquarePaymentSeen {
  id               String    @id @default(cuid())
  squarePaymentId  String    @unique
  squareOrderId    String?
  squareCustomerId String?
  amountCents      Int
  status           String
  paidAt           DateTime?
  sourceType       String?
  state            String
  invoiceId        String?
  paymentId        String?
  note             String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([state])
}
